# Component templates. A importer apres les politiques ILM.

PUT _component_template/logs@custom
{
  "template": {
    "mappings": {
      "properties": {
        "log":   { "properties": { "logger": { "type": "keyword", "ignore_above": 1024 } } },
        "event": { "properties": {
          "action":  { "type": "keyword", "ignore_above": 1024 },
          "outcome": { "type": "keyword", "ignore_above": 1024 }
        } },
        "error": { "properties": {
          "type":        { "type": "keyword", "ignore_above": 1024 },
          "message":     { "type": "match_only_text" },
          "stack_trace": { "type": "wildcard", "fields": { "text": { "type": "match_only_text" } } }
        } },
        "milo": { "properties": {
          "error_response": { "properties": {
            "code":    { "type": "keyword", "ignore_above": 1024 },
            "message": { "type": "match_only_text" }
          } }
        } },
        "http": { "properties": {
          "response": { "properties": {
            "www_authenticate": { "type": "keyword", "ignore_above": 1024 },
            "retry_after":      { "type": "keyword", "ignore_above": 1024 }
          } }
        } },
        "login": { "properties": {
          "step": { "type": "keyword", "ignore_above": 1024 }
        } }
      }
    }
  },
  "_meta": { "description": "Champs ECS custom CEJ, communs app + router", "managed_by": "pass-emploi-tools" },
  "version": 5
}

PUT _component_template/logs-router@mappings
{
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": { "type": "date" },
        "service": { "properties": {
          "name": { "type": "keyword" },
          "node": { "properties": { "name": { "type": "keyword" } } }
        } },
        "client": { "properties": { "ip": { "type": "ip" } } },
        "http": { "properties": {
          "request":  { "properties": {
            "id": { "type": "keyword" }, "method": { "type": "keyword" }, "referrer": { "type": "keyword" }
          } },
          "response": { "properties": {
            "status_code": { "type": "short" },
            "body": { "properties": { "bytes": { "type": "long" } } }
          } }
        } },
        "url": { "properties": {
          "path": { "type": "wildcard" }, "scheme": { "type": "keyword" }, "domain": { "type": "keyword" }
        } },
        "event": { "properties": { "duration": { "type": "long" } } },
        "user_agent": { "properties": {
          "original": { "type": "keyword", "fields": { "text": { "type": "text" } } }
        } },
        "message": { "type": "text" }
      }
    }
  },
  "_meta": { "description": "Champs propres aux logs router Scalingo. dynamic:false ; event.action/outcome viennent de logs@custom", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-router@settings
{
  "template": {
    "settings": { "index": {
      "number_of_shards": "1",
      "number_of_replicas": "1"
    } }
  },
  "_meta": { "description": "Settings index des data streams router (shards/replicas ; rétention portée par logs-router-retention-custom)", "managed_by": "pass-emploi-tools" },
  "version": 2
}

# Briques de rétention (une par flux, lifecycle uniquement) — pattern homogène
# avec les briques `<flux>@custom` de observabilite.console.
PUT _component_template/logs-logstash-errors-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-logstash-errors-retention" } } } },
  "_meta": { "description": "Retention logs d'erreurs de traitement Logstash (30j)", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-logstash-dlq-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-logstash-dlq-retention" } } } },
  "_meta": { "description": "Retention events Dead Letter Queue Logstash (30j)", "managed_by": "pass-emploi-tools" },
  "version": 1
}

