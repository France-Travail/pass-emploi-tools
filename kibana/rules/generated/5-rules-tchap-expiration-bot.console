# ⚠️ FICHIER GÉNÉRÉ par ../scripts/generer-regles-alerting.py : NE PAS LE MODIFIER, il serait écrasé.
# À modifier à la place, dans ../5-tchap-expiration-bot/ :
#   - une règle : son fichier <code>.json (le JSON de la règle Kibana) ;
#   - le texte autour des règles (commentaires, autres requêtes) : _modele.console.
# Puis : python3 -I ../scripts/generer-regles-alerting.py
#        python3 -I ../scripts/generer-notifications-tchap.py
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
# Ce fichier se colle tel quel dans Kibana → Dev Tools. Mode d'emploi : ../README.md.
#
# Expiration du compte bot Tchap : la règle. Spécification et procédure :
# ../../../docs/observabilite/runbooks/runbook-tchap-expiration-bot.md.
#
# Elle lit l'index tchap-expiration-bot : son pipeline et son modèle sont dans
# ../../../elasticsearch/tchap-expiration-bot.console, à rejouer avant elle.

# expiration-bot — Le compte du bot Tchap expire-t-il bientôt ?
# La règle filtre sur renouveler_a_partir_du (date passée dès J-60) dans une
# fenêtre de 2 ans : la fenêtre de temps d'une règle ne regarde que le passé,
# une date d'expiration future n'y entrerait jamais. Pas
# d'excludeHitsFromPreviousRun : le rappel est quotidien tant que la date n'est
# pas mise à jour.
DELETE kbn:/api/alerting/rule/bcd45d7d-6fe6-4303-a73e-7cff877dde96
POST kbn:/api/alerting/rule/bcd45d7d-6fe6-4303-a73e-7cff877dde96
{
  "name": "Tchap - Expiration du compte bot",
  "rule_type_id": ".es-query",
  "consumer": "alerts",
  "tags": [
    "critical",
    "prod",
    "o11y",
    "tchap",
    "tchap-lignes"
  ],
  "schedule": {
    "interval": "1d"
  },
  "params": {
    "searchType": "esQuery",
    "esQuery": "{\"query\":{\"match_all\":{}}}",
    "index": [
      "tchap-expiration-bot"
    ],
    "timeField": "renouveler_a_partir_du",
    "timeWindowSize": 730,
    "timeWindowUnit": "d",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 1,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": false,
    "sourceFields": []
  },
  "actions": [
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-o11y-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ]
}
