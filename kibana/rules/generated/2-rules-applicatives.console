    "windows": [
      {
        "id": "alert",
        "actionGroup": "slo.burnRate.alert",
        "burnRateThreshold": 3,
        "maxBurnRateThreshold": 6.67,
        "longWindow": {
          "value": 1,
          "unit": "h"
        },
        "shortWindow": {
          "value": 5,
          "unit": "m"
        }
      },
      {
        "id": "high",
        "actionGroup": "slo.burnRate.high",
        "burnRateThreshold": 2,
        "maxBurnRateThreshold": 6.67,
        "longWindow": {
          "value": 6,
          "unit": "h"
        },
        "shortWindow": {
          "value": 30,
          "unit": "m"
        }
      },
      {
        "id": "medium",
        "actionGroup": "slo.burnRate.medium",
        "burnRateThreshold": 1.5,
        "maxBurnRateThreshold": 6.67,
        "longWindow": {
