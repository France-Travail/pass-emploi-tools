# ⚠️ FICHIER GÉNÉRÉ par ../../rules/scripts/generer-regles-alerting.py : NE PAS LE MODIFIER, il serait écrasé.
# À modifier à la place : l'objectif d'un SLO dans ../seuils.json, le reste dans ../_modele.console.
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
#
# SLO Kibana — prod. Ce qu'ils promettent : docs/observabilite/slo.md.
#
# L'objectif de chaque SLO (sa cible, et son pourcentage dans une description) vient de
# seuils.json, à la clé du code de sa règle burn rate (rules/2-applicatives/SLO*.json).
# Idempotent : chaque SLO est supprimé puis recréé avec le même id (DELETE puis POST) ;
# rejouer tout le fichier dans Dev Tools, qu'il existe déjà ou non. Recréer un SLO
# relance le calcul de ses 30 jours : ses règles burn rate peuvent sonner à tort
# pendant ce calcul.
#
# service.name est indispensable dans les filtres api : logs-prod-default reçoit
# aussi les requêtes du web et de connect.
#
# SLO « API — disponibilité par parcours » : une requête est bonne si son status
# est < 500. Un 4xx est une réponse juste du service ; il reste visible dans
# l'alerte des refus anormaux d'un parcours.

DELETE kbn:/api/observability/slos/57e45f52-6c4c-45a4-8aa0-c5885c35e55f
POST kbn:/api/observability/slos
{
  "id": "57e45f52-6c4c-45a4-8aa0-c5885c35e55f",
  "name": "API — disponibilité par parcours",
  "description": "99,5 % des requêtes de chaque parcours servies sans erreur serveur (status < 500). Un 4xx est une réponse juste du service.",
  "indicator": {
    "type": "sli.kql.custom",
    "params": {
      "index": "logs-prod-default",
      "filter": "service.name: pass-emploi-api and event.action: (request_completed or request_failed) and labels.user_journey: *",
      "good": "http.response.status_code < 500",
      "total": "*",
      "timestampField": "@timestamp"
    }
  },
  "timeWindow": { "duration": "30d", "type": "rolling" },
  "budgetingMethod": "occurrences",
  "objective": { "target": 0.995 },
  "groupBy": "labels.user_journey",
  "tags": ["prod", "api", "disponibilite"]
}

DELETE kbn:/api/observability/slos/ec53b7e4-604e-4e33-a4df-ace9e4aea01b
POST kbn:/api/observability/slos
{
  "id": "ec53b7e4-604e-4e33-a4df-ace9e4aea01b",
  "name": "Login — réussite jeune France Travail",
  "description": "Login de bout en bout (pass-emploi-connect), hors refus métier. Objectif à relever à mesure que les OPError et SessionNotFound se résorbent.",
  "indicator": {
    "type": "sli.kql.custom",
    "params": {
      "index": "logs-prod-default",
      "filter": "event.action: (login_completed or login_failed) and not error.type: UTILISATEUR_NON_TRAITABLE and labels.idp: francetravail-jeune",
      "good": "event.action: login_completed",
      "total": "*",
      "timestampField": "@timestamp"
    }
  },
  "timeWindow": { "duration": "30d", "type": "rolling" },
  "budgetingMethod": "occurrences",
  "objective": { "target": 0.85 },
  "groupBy": "*",
  "tags": ["prod", "connect", "login"]
}

