<configuration>
  <!-- Sans ce fichier, Logback applique sa configuration par défaut — root à
       DEBUG sur la console — et le debug de Netty et du moteur HTTP noie le
       résumé de progression du tir. Celui-ci est écrit par le ConsoleDataWriter
       de Gatling sur System.out et ne passe pas par Logback : il survit donc à
       ce filtrage. -->

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{15} - %msg%n%rEx</pattern>
      <immediateFlush>false</immediateFlush>
    </encoder>
  </appender>

  <!-- DEBUG journalise les requêtes et réponses **en échec** (corps compris),
       TRACE toutes les requêtes. Piloté par JOURNAL_HTTP pour qu'un tir de
       diagnostic n'exige pas de modifier ce fichier — mais à laisser à INFO
       pour un tir de mesure : le coût de log fausse la mesure, et un tir qui
       échoue massivement produit des mégaoctets de corps de réponse. -->
  <logger name="io.gatling.http.engine.response" level="${JOURNAL_HTTP:-INFO}"/>

  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
