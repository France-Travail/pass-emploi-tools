state.?secret.api_token.orValue(state.?api_token.orValue("")).as(api_token,
request("POST", state.auth_url).with({
  "Header": {"Authorization": ["Basic " + (":" + api_token).base64()]},
}).do_request().as(auth,
  auth.StatusCode != 200 && auth.StatusCode != 201 ?
    state.with({
      "events": [{"error": {"message": "Scalingo tokens/exchange : HTTP " + string(auth.StatusCode)}}],
      "want_more": false,
    })
  :
    auth.Body.decode_json().token.as(jwt,
      state.with({
        "events": state.bases.map(base,
          request("POST", state.url + "/v1/apps/" + base.app + "/addons/" + base.addon_id + "/token").with({
            "Header": {"Authorization": ["Bearer " + jwt], "Accept": ["application/json"]},
          }).do_request().as(jeton,
            jeton.StatusCode != 200 && jeton.StatusCode != 201 ?
              dyn([{"error": {"message": "Scalingo token de la base " + base.nom + " : HTTP " + string(jeton.StatusCode)}}])
            :
              request("GET", state.db_api_url + "/api/databases/" + base.addon_id + "/metrics").with({
                "Header": {
                  "Authorization": ["Bearer " + jeton.Body.decode_json().addon.token],
                  "Accept": ["application/json"],
                },
              }).do_request().as(resp,
                resp.StatusCode != 200 ?
                  dyn([{"error": {"message": "Scalingo métriques de la base " + base.nom + " : HTTP " + string(resp.StatusCode)}}])
                :
                  dyn(resp.Body.decode_json().as(m,
                    m.instances_metrics.map(id, m.instances_metrics[id]).map(i, {
                      "scalingo": {
                        "database": {
                          "nom": base.nom,
                          "app": base.app,
                          "addon_id": base.addon_id,
                          "instance": i.instance_id,
                        }.with(has(base.connexions_max) ? {"connexions_max": base.connexions_max} : {})
                        .with(m.?database_stats.?data_size.hasValue() ? {"data_size": {"bytes": int(m.database_stats.data_size)}} : {}),
                        "cpu": {"usage": i.cpu.usage_in_percents},
                        "memory": {
                          "usage": {"bytes": int(i.memory.memory_usage)},
                          "limit": {"bytes": int(i.memory.memory_limit)},
                          "highest": {"bytes": int(i.memory.max_memory_usage)},
                          "pct": i.memory.memory_limit > 0.0 ? double(i.memory.memory_usage) / double(i.memory.memory_limit) : 0.0,
                        },
                        "swap": {"usage": {"bytes": int(i.memory.swap_usage)}},
                        "disk": {
                          "usage": {"bytes": int(i.real_disk_size)},
                          "inclus": {"bytes": int(base.disque_inclus_octets)},
                          "pct": base.disque_inclus_octets > 0 ? double(i.real_disk_size) / double(base.disque_inclus_octets) : 0.0,
                        },
                      },
                    })
                  ))
              )
          )
        ).flatten(),
        "want_more": false,
      })
    )
)
)
