}

# X4 — CVE high/critical encore ouvertes, à chaque passage de security-alerts.yml (Critical)
POST kbn:/api/alerting/rule/67846c2c-45d1-45be-89f5-ce9a340240a0
{
  "name": "GitHub - CVE high ou critical ouverte",
  "tags": [
    "critical",
    "prod",
    "alertes-externes",
    "securite"
  ],
  "schedule": {
    "interval": "5m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "vulnerability.severity : (\"high\" or \"critical\")",
        "language": "kuery"
      },
      "index": {
        "id": "8a589b67-53bc-407d-9d76-c68b41271bbe",
        "title": "logs-alertes-github-default",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Alertes GitHub - CVE",
        "allowHidden": false,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 10,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **CVE high/critical ouvertes** ({{context.value}})",
  "attachments": [
    {
      "color": "#d00000",
      "text": "{{#context.hits}}• `{{_source.service.name}}` : **{{_source.vulnerability.id}}** — {{_source.package.name}} ({{_source.vulnerability.severity}}) : {{_source.vulnerability.description}} — [Voir]({{_source.vulnerability.reference}})\n{{/context.hits}}",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Alertes externes - CVE Dependabot](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/ece3e409-0679-4bcb-a675-ae7dfb092c19), liste les CVE ouvertes par repo avec leur score ; puis l'alerte Dependabot de chacune (lien Voir), à traiter selon sa sévérité" },
        { "title": "Documents", "value": "[Ouvrir dans Discover]({{context.link}})" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts"
}

# X5 — Document rejeté par le pipeline ou par Elasticsearch (Warning). L'émetteur
# reçoit 201 même quand le document part au failure store : sans cette règle, un
# changement de format chez Scalingo ou GitHub, ou un notifier qui vise le
# mauvais environnement, passerait inaperçu.
POST kbn:/api/alerting/rule/ae398f47-0ed9-427e-a090-cf774acc7d16
{
  "name": "Alertes externes - Payload rejeté (failure store)",
  "tags": [
    "warning",
    "prod",
    "o11y",
    "alertes-externes"
  ],
  "schedule": {
    "interval": "5m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "",
        "language": "kuery"
      },
      "index": {
        "id": "0f25bbf6-abdf-41f9-8bab-4a4911c13ebc",
        "title": "logs-alertes-scalingo-prod-default::failures,logs-alertes-scalingo-staging-default::failures,logs-alertes-scalingo-perf-default::failures,logs-alertes-github-default::failures",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Alertes externes - rejets (failure store)",
        "allowHidden": true,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 10,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "d2812573-52bf-4b48-9e54-a79a8b5b227d",
      "params": {
        "body": """{
  "text": "⚠️ **Alertes externes rejetées** ({{context.value}}) — des notifications Scalingo ou GitHub ne sont pas arrivées dans Kibana : leur émetteur a pourtant reçu un succès.",
  "attachments": [
    {
      "color": "#ffa500",
      "text": "{{#context.hits}}• `{{_source.error.type}}` : {{_source.error.message}}\n{{/context.hits}}",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Alertes externes - Rejets (failure store)](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/861dbdf4-5086-498b-aff6-4d9d68ceb1f4), `error.type` et `error.message` donnent le motif du rejet ; puis le payload d'origine (`document.source`) pour adapter le pipeline et le rejouer en _simulate" },
        { "title": "Documents", "value": "[Ouvrir dans Discover]({{context.link}})" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-o11y-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts"
}
