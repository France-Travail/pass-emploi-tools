# Règles Kibana des alertes externes (notifiers Scalingo, CVE Dependabot), lues
# dans logs-alertes-scalingo-<env>-default et logs-alertes-github-default.
# Spécification : ../alertes-externes.md.
#
# Création : POST ci-dessous, à rejouer dans Dev Tools après les pipelines
# (../pipelines/). Pour une mise à jour, PUT sur la même URL avec le même corps
# SANS "rule_type_id" ni "consumer".
#
# Chaque événement est notifié une fois : excludeHitsFromPreviousRun ne compte
# que les documents arrivés depuis l'exécution précédente, et onActiveAlert
# notifie chaque exécution qui en trouve, en les listant. La fenêtre, plus
# large que l'intervalle, rattrape un document indexé en retard sans le
# notifier deux fois.
# Pas de groupBy top par app : Kibana y ignore excludeHitsFromPreviousRun et
# renotifierait le même événement à chaque minute (constaté en test, 9.4.7).
#
# Chaque règle notifie aussi Tchap : action .workflows vers le Workflow du salon
# (../workflows/tchap/). ongoing: true est nécessaire, une alerte restant active
# tant que des événements arrivent ; recovered: false évite un message à la fin
# de l'alerte. Les actions Mattermost sont retirées le 1er novembre 2026.

# X1 — Scalingo prod : crash, redémarrage, arrêt (Critical)
POST kbn:/api/alerting/rule/1b97f0e0-870f-498d-8dd7-1c2f9aeba665
{
  "name": "Scalingo - Prod - Crash, redémarrage ou arrêt d'une app",
  "tags": [
    "critical",
    "prod",
    "alertes-externes"
  ],
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "event.action : (\"app_crashed\" or \"app_crashed_repeatedly\" or \"app_restarted\" or \"app_stopped\")",
        "language": "kuery"
      },
      "index": {
        "id": "d327d85c-91ea-4092-867f-08a940504c96",
        "title": "logs-alertes-scalingo-prod-default",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Alertes Scalingo - Prod",
        "allowHidden": false,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **Apps Scalingo de prod crashées, redémarrées ou arrêtées** ({{context.value}})",
  "attachments": [
    {
      "color": "#d00000",
      "text": "{{#context.hits}}• `{{_source.service.name}}` : `{{_source.event.action}}`{{#_source.event.reason}} ({{_source.event.reason}}){{/_source.event.reason}}{{#_source.labels.scope}} sur `{{_source.labels.scope}}`{{/_source.labels.scope}}{{#_source.user.name}}, par {{_source.user.name}}{{/_source.user.name}}\n{{/context.hits}}",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Alertes externes de Prod - Événements Scalingo](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/bb62451a-d9e9-4141-ab6f-2bda0e384e87), onglet « Crashs, redémarrages et arrêts » : l'événement, sa raison et son auteur ; puis l'impact au même moment : pour `pass-emploi-api`, le Discover [[Pass Emploi] Logs de Prod - Erreurs serveur 5xx](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/d076df50-1625-443b-978c-1aa9a1288e73) ; pour une app Logstash, les Discover [[Pass Emploi] Logs de Prod - DLQ Logstash Process](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/97e2d85f-7bd2-49df-86b3-2ffc290bbe69) et [[Pass Emploi] Logs de PROD - Erreurs de traitement Logstash Process](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/f10de9e3-0fdd-4761-9d44-bacc96504e17) (logs non indexés) ; enfin l'onglet Activity de l'app dans le dashboard Scalingo" },
        { "title": "Documents", "value": "[Ouvrir dans Discover]({{context.link}})" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts"
}

# X2 — Scalingo prod : seuil d'alerte Scalingo franchi (Warning)
POST kbn:/api/alerting/rule/c16f2ab5-6103-4f69-bdc3-b4a10a38deb0
{
  "name": "Scalingo - Prod - Seuil de ressource dépassé",
  "tags": [
    "warning",
    "prod",
    "alertes-externes"
  ],
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "event.action : \"resource_threshold_exceeded\"",
        "language": "kuery"
      },
      "index": {
        "id": "d327d85c-91ea-4092-867f-08a940504c96",
        "title": "logs-alertes-scalingo-prod-default",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Alertes Scalingo - Prod",
        "allowHidden": false,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "⚠️ **Seuils de ressource Scalingo dépassés en prod** ({{context.value}})",
  "attachments": [
    {
      "color": "#ffa500",
      "text": "{{#context.hits}}• `{{_source.service.name}}` : {{_source.labels.metric}} à {{_source.labels.value_text}} (seuil {{_source.labels.limit_text}}){{#_source.service.node.name}} sur `{{_source.service.node.name}}`{{/_source.service.node.name}}\n{{/context.hits}}",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Alertes externes de Prod - Événements Scalingo](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/bb62451a-d9e9-4141-ab6f-2bda0e384e87), onglet « Seuils de ressource » : la métrique, sa valeur et son seuil par app ; puis l'impact au même moment : pour `pass-emploi-api`, le Discover [[Pass Emploi] Logs de Prod - Erreurs serveur 5xx](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/d076df50-1625-443b-978c-1aa9a1288e73) ; pour une app Logstash, les Discover [[Pass Emploi] Logs de Prod - DLQ Logstash Process](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/97e2d85f-7bd2-49df-86b3-2ffc290bbe69) et [[Pass Emploi] Logs de PROD - Erreurs de traitement Logstash Process](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/f10de9e3-0fdd-4761-9d44-bacc96504e17) (logs non indexés) ; enfin les métriques de l'app dans le dashboard Scalingo (onglet Metrics) et ses derniers déploiements" },
        { "title": "Documents", "value": "[Ouvrir dans Discover]({{context.link}})" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts"
}

