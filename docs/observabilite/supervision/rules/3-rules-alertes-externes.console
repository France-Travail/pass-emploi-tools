        "allowHidden": false,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "⚠️ **Seuils de ressource Scalingo dépassés en prod** ({{context.value}})",
  "attachments": [
    {
      "color": "#ffa500",
      "text": "{{#context.hits}}• `{{_source.service.name}}` : {{_source.labels.metric}} à {{_source.labels.value_text}} (seuil {{_source.labels.limit_text}}){{#_source.service.node.name}} sur `{{_source.service.node.name}}`{{/_source.service.node.name}}\n{{/context.hits}}",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "À vérifier", "value": "Les métriques de l'app dans le dashboard Scalingo (onglet Metrics) et ses derniers déploiements" },
        { "title": "Documents", "value": "[Ouvrir dans Discover]({{context.link}})" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts"
}

