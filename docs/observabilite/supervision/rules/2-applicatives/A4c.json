{
  "_id": "121f4b04-f90d-4423-af1f-ae1344a5f7db",
  "_commentaire": [
    "# A4c — Opérations d'infra Scalingo des apps applicatives, prod (ℹ️, salon infra-production)"
  ],
  "name": "Scalingo - Prod - Opérations d'infra des apps applicatives",
  "tags": [
    "prod",
    "applicatif",
    "scalingo",
    "tchap-lignes",
    "info"
  ],
  "artifacts": {
    "investigation_guide": {
      "blob": "## Dashboards\n\n- [[Scalingo] Dashboard des apps](https://dashboard.scalingo.com/apps)\n"
    }
  },
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "not service.name : (\"pass-emploi-logstash\" or \"pass-emploi-logstash-process\" or \"pass-emploi-elastic-agent\" or \"pass-emploi-heartbeat\") and labels.categorie : \"infra\"",
        "language": "kuery"
      },
      "index": {
        "id": "d327d85c-91ea-4092-867f-08a940504c96",
        "title": "logs-alertes-scalingo-prod-default",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Alertes Scalingo - Prod",
        "allowHidden": false,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": {
          "text": "**Opérations d'infra Scalingo des apps de prod** ({{context.value}})",
          "attachments": [
            {
              "color": "#808080",
              "text": "{{#context.hits}}{{_source.message}}\n{{/context.hits}}",
              "fields": [
                {
                  "title": "Règle",
                  "value": "`{{rule.name}}`",
                  "short": true
                },
                {
                  "title": "Dashboards",
                  "value": "[[Scalingo] Dashboard des apps](https://dashboard.scalingo.com/apps)"
                }
              ]
            }
          ]
        }
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-infra-production",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ]
}
