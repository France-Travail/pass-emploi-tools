# ⚠️ FICHIER GÉNÉRÉ par ../generer-regles.py : NE PAS LE MODIFIER, il serait écrasé.
# À modifier à la place, dans ../1-securite/ :
#   - une règle : son fichier <code>.json (le JSON de la règle Kibana) ;
#   - le texte autour des règles (commentaires, autres requêtes) : _modele.console.
# Puis : python3 -I ../generer-regles.py
#        python3 -I ../../workflows/tchap/generer-workflows.py
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
# Ce fichier se colle tel quel dans Kibana → Dev Tools. Mode d'emploi : ../README.md.
#
# Règles Kibana des alertes de sécurité. Spécification : ../../alertes-securite.md.
#
# À rejouer dans Dev Tools, après les sessions Discover de
# ../../discovers/webhooks/. PUT met à jour une règle existante ; sur un
# cluster vide, la créer avec POST kbn:/api/alerting/rule/<id> et le même corps
# plus "rule_type_id": ".es-query" et "consumer": "alerts".
# Déployé par l'API avec une clé API : « Update API keys » ensuite, cf.
# ../../objets-kibana.md#slo-et-règles-console.
#
# Messages Mattermost : une section (« À vérifier », « Dashboards », « Discover
# sessions ») = un champ, un élément par ligne (`\n`). Chaque champ tient sur une
# seule ligne du fichier : l'éditeur de règle de Kibana lit le body comme du JSON
# brut, un retour à la ligne dans une chaîne l'empêche de l'afficher. Pour relire
# les étapes : le fichier <code>.json de la règle, dans ../1-securite/, ou son
# Investigation guide.
#
# artifacts : l'Investigation guide et les Related dashboards (onglets de la
# règle). L'API publique ne les renvoie pas dans ses réponses : les vérifier
# dans l'interface.

# S1 — CVE high/critical encore ouvertes, à chaque passage de security-alerts.yml (Critical)
PUT kbn:/api/alerting/rule/67846c2c-45d1-45be-89f5-ce9a340240a0
{
  "name": "GitHub - CVE high ou critical ouverte",
  "tags": [
    "critical",
    "prod",
    "securite",
    "tchap-lignes"
  ],
  "artifacts": {
    "investigation_guide": {
      "blob": "## Ce que signale l'alerte\n\nUne CVE high ou critical est encore ouverte sur un repo (alertes Dependabot envoyées par `security-alerts.yml`).\n\n## À vérifier\n\n1. Le Discover [[Pass Emploi] Alertes externes - CVE Dependabot](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/ece3e409-0679-4bcb-a675-ae7dfb092c19), liste les CVE ouvertes par repo avec leur score\n2. Les alertes Dependabot du repo concerné, à traiter selon leur sévérité : [[GitHub] Alertes Dependabot - pass-emploi-api](https://github.com/France-Travail/pass-emploi-api/security/dependabot), [[GitHub] Alertes Dependabot - pass-emploi-web](https://github.com/France-Travail/pass-emploi-web/security/dependabot), [[GitHub] Alertes Dependabot - pass-emploi-connect](https://github.com/France-Travail/pass-emploi-connect/security/dependabot)\n\n## Dashboards\n\n- [[GitHub] Alertes Dependabot - pass-emploi-api](https://github.com/France-Travail/pass-emploi-api/security/dependabot)\n- [[GitHub] Alertes Dependabot - pass-emploi-web](https://github.com/France-Travail/pass-emploi-web/security/dependabot)\n- [[GitHub] Alertes Dependabot - pass-emploi-connect](https://github.com/France-Travail/pass-emploi-connect/security/dependabot)\n\n## Discover sessions\n\n- [[Pass Emploi] Alertes externes - CVE Dependabot](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/ece3e409-0679-4bcb-a675-ae7dfb092c19)\n\n## Documentation\n\n[Alertes de sécurité](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/supervision/alertes-securite.md)\n"
    }
  },
  "schedule": {
    "interval": "5m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "vulnerability.severity : (\"high\" or \"critical\")",
        "language": "kuery"
      },
      "index": {
        "id": "8a589b67-53bc-407d-9d76-c68b41271bbe",
        "title": "logs-alertes-github-default",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Alertes GitHub - CVE",
        "allowHidden": false,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 10,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 20,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": true,
    "sourceFields": []
  },
  "actions": [
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-securite",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": true,
            "recovered": false
          }
        }
      }
    }
  ]
}

# S2a — Suspicion d'attaque DDoS, de prod (Critical) : alertes de métriques Scalingo RPM et 5xx
# de la même app, à moins de 10 min d'intervalle, pas encore revenues à la normale.
# Nouvelle règle : la première fois, la créer avec POST sur la même URL, en ajoutant
# "rule_type_id" et "consumer" à la racine du corps, au même niveau que "name" (pas dans "params") :
#   POST kbn:/api/alerting/rule/4b2e9f71-6c3d-4a85-b0e7-9d1f2c3a5e68
#   {
#     "rule_type_id": ".es-query",
#     "consumer": "alerts",
#     "name": "Scalingo - Prod - Suspicion d'attaque DDoS",
#     "tags": [...], "artifacts": {...}, "schedule": {...}, "params": {...}, "actions": [...]
#   }
# Ensuite, ce bloc tel quel, en PUT (qui refuse ces deux champs).
PUT kbn:/api/alerting/rule/4b2e9f71-6c3d-4a85-b0e7-9d1f2c3a5e68
{
  "name": "Scalingo - Prod - Suspicion d'attaque DDoS",
  "tags": [
    "critical",
    "prod",
    "securite",
    "scalingo"
  ],
  "artifacts": {
    "investigation_guide": {
      "blob": "## Ce que signale l'alerte\n\nSur une app applicative de prod, les alertes de métriques Scalingo des requêtes par minute (RPM) et des erreurs 5xx sont déclenchées à moins de 10 min d'intervalle, et aucune n'est revenue à la normale : le trafic dépasse ce que l'app absorbe et elle commence à refuser des requêtes. Signe d'une attaque par déni de service, d'un compte qui envoie des requêtes en masse, ou d'un pic légitime. Ne dépend pas des logs : les alertes arrivent de Scalingo par webhook.\n\n## À vérifier\n\n1. Quelle app, depuis quand, et le trafic continue-t-il de monter : ses métriques (onglet Metrics) dans le dashboard [[Scalingo] Dashboard des apps](https://dashboard.scalingo.com/apps)\n2. Un événement légitime l'explique-t-il : mise en service, notification de masse, campagne de communication\n3. D'où vient le trafic : si les logs du routeur arrivent encore (règle [Logstash - Prod - Détection absence ingestion logs router](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/management/insightsAndAlerting/triggersActions/rule/6c2a2a83-9c40-4f40-af8d-911402932417) au repos), le Discover [[Pass Emploi] Logs de Prod - Trafic du routeur par IP](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13) sur la période ; sinon, les logs du routeur lus directement chez Scalingo, sans drain ni Logstash : `scalingo --region osc-secnum-fr1 --app <app> logs --lines 5000`, IP dans `from=`, puis le support Scalingo\n\n## Dashboards\n\n- [[Scalingo] Dashboard des apps](https://dashboard.scalingo.com/apps)\n\n## Discover sessions\n\n- [[Pass Emploi] Logs de Prod - Trafic du routeur par IP](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13)\n\n## Runbook\n\n- [Investiguer un incident applicatif](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md#suspicion-de-ddos-ou-surcharge-de-linfra)\n\n## Documentation\n\n[Alertes de sécurité](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/supervision/alertes-securite.md)\n"
    },
    "dashboards": []
  },
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchType": "esqlQuery",
    "esqlQuery": {
      "esql": """FROM logs-alertes-scalingo-prod-default
| WHERE event.kind == "alert" AND labels.metric IN ("Requests per Minute", "5xx Errors")
| INLINE STATS dernier_evenement = MAX(@timestamp) BY service.name, service.environment, labels.metric
| WHERE @timestamp == dernier_evenement AND event.action == "resource_threshold_exceeded"
| STATS metriques = COUNT_DISTINCT(labels.metric), depuis = MIN(@timestamp), jusqu_a = MAX(@timestamp), rpm = MAX(CASE(labels.metric == "Requests per Minute", labels.value_text, null)), erreurs_5xx = MAX(CASE(labels.metric == "5xx Errors", labels.value_text, null)) BY service.name, service.environment
| WHERE metriques == 2 AND DATE_DIFF("minute", depuis, jusqu_a) <= 10
| EVAL app = CONCAT(service.name, "-", service.environment)
| KEEP app, rpm, erreurs_5xx, depuis"""
    },
    "timeField": "@timestamp",
    "timeWindowSize": 45,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "groupBy": "all"
  },
  "actions": [
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-securite",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": false,
            "recovered": false
          }
        }
      }
    }
  ]
}

# S2b — Suspicion d'attaque DDoS, de staging ou de perf (Critical) : alertes de métriques Scalingo RPM et 5xx
# de la même app, à moins de 10 min d'intervalle, pas encore revenues à la normale.
# Nouvelle règle : la première fois, la créer avec POST sur la même URL, en ajoutant
# "rule_type_id" et "consumer" à la racine du corps, au même niveau que "name" (pas dans "params") :
#   POST kbn:/api/alerting/rule/8e5a1d34-2f7b-4c90-a6d8-3b4c5e6f7a81
#   {
#     "rule_type_id": ".es-query",
#     "consumer": "alerts",
#     "name": "Scalingo - Hors-Prod - Suspicion d'attaque DDoS",
#     "tags": [...], "artifacts": {...}, "schedule": {...}, "params": {...}, "actions": [...]
#   }
# Ensuite, ce bloc tel quel, en PUT (qui refuse ces deux champs).
PUT kbn:/api/alerting/rule/8e5a1d34-2f7b-4c90-a6d8-3b4c5e6f7a81
{
  "name": "Scalingo - Hors-Prod - Suspicion d'attaque DDoS",
  "tags": [
    "critical",
    "hors-prod",
    "securite",
    "scalingo"
  ],
  "artifacts": {
    "investigation_guide": {
      "blob": "## Ce que signale l'alerte\n\nSur une app applicative de staging ou de perf, les alertes de métriques Scalingo des requêtes par minute (RPM) et des erreurs 5xx sont déclenchées à moins de 10 min d'intervalle, et aucune n'est revenue à la normale : le trafic dépasse ce que l'app absorbe et elle commence à refuser des requêtes. Signe d'une attaque par déni de service, d'un compte qui envoie des requêtes en masse, ou d'un pic légitime. Ne dépend pas des logs : les alertes arrivent de Scalingo par webhook.\n\n## À vérifier\n\n1. Quelle app, depuis quand, et le trafic continue-t-il de monter : ses métriques (onglet Metrics) dans le dashboard [[Scalingo] Dashboard des apps](https://dashboard.scalingo.com/apps)\n2. Un événement légitime l'explique-t-il : mise en service, notification de masse, campagne de communication\n3. D'où vient le trafic : si les logs du routeur arrivent encore (règle [Logstash - Prod - Détection absence ingestion logs router](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/management/insightsAndAlerting/triggersActions/rule/6c2a2a83-9c40-4f40-af8d-911402932417) au repos), le Discover [[Pass Emploi] Logs de Prod - Trafic du routeur par IP](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13) sur la période ; sinon, les logs du routeur lus directement chez Scalingo, sans drain ni Logstash : `scalingo --region osc-secnum-fr1 --app <app> logs --lines 5000`, IP dans `from=`, puis le support Scalingo\n\n## Dashboards\n\n- [[Scalingo] Dashboard des apps](https://dashboard.scalingo.com/apps)\n\n## Discover sessions\n\n- [[Pass Emploi] Logs de Prod - Trafic du routeur par IP](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13)\n\n## Runbook\n\n- [Investiguer un incident applicatif](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md#suspicion-de-ddos-ou-surcharge-de-linfra)\n\n## Documentation\n\n[Alertes de sécurité](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/supervision/alertes-securite.md)\n"
    },
    "dashboards": []
  },
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchType": "esqlQuery",
    "esqlQuery": {
      "esql": """FROM logs-alertes-scalingo-staging-default,logs-alertes-scalingo-perf-default
| WHERE event.kind == "alert" AND labels.metric IN ("Requests per Minute", "5xx Errors")
| INLINE STATS dernier_evenement = MAX(@timestamp) BY service.name, service.environment, labels.metric
| WHERE @timestamp == dernier_evenement AND event.action == "resource_threshold_exceeded"
| STATS metriques = COUNT_DISTINCT(labels.metric), depuis = MIN(@timestamp), jusqu_a = MAX(@timestamp), rpm = MAX(CASE(labels.metric == "Requests per Minute", labels.value_text, null)), erreurs_5xx = MAX(CASE(labels.metric == "5xx Errors", labels.value_text, null)) BY service.name, service.environment
| WHERE metriques == 2 AND DATE_DIFF("minute", depuis, jusqu_a) <= 10
| EVAL app = CONCAT(service.name, "-", service.environment)
| KEEP app, rpm, erreurs_5xx, depuis"""
    },
    "timeField": "@timestamp",
    "timeWindowSize": 45,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "groupBy": "all"
  },
  "actions": [
    {
      "id": "system-connector-.workflows",
      "params": {
        "subAction": "run",
        "subActionParams": {
          "workflowId": "tchap-monitoring-staging",
          "summaryMode": true,
          "alertStates": {
            "new": true,
            "ongoing": false,
            "recovered": false
          }
        }
      }
    }
  ]
}
