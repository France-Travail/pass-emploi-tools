# Règles Kibana des alertes applicatives, notifiées dans #monitoring-production
# (connecteur Mattermost-monitoring-production). Spécification : ../alertes-applicatives.md.
#
# À rejouer dans Dev Tools, après ../slo/1-slos.console. PUT met à jour une règle
# existante ; sur un cluster vide, la créer avec POST kbn:/api/alerting/rule/<id>
# et le même corps plus "rule_type_id" et "consumer" (slo.rules.burnRate / slo pour
# S2 et S3, .es-query / alerts pour A1 à A3).
#
# S2, S3 — SLO burn rate. Seuls Critical (slo.burnRate.alert) et High notifient.
#
# maxBurnRateThreshold = 1 / (1 - objectif) : burn rate à 100 % d'échecs.
#
# Invité et conseiller départemental : quelques tentatives par jour, un seul échec
# sur 1 h vaut 100 % d'échecs. Une seule fenêtre, longue, qui exige plusieurs
# échecs : invité ≥ 20 % d'échecs sur 72 h (~18 tentatives), conseiller
# départemental ≥ 20 % sur 168 h (~10 tentatives).

PUT kbn:/api/alerting/rule/e41ef1d8-efd8-449b-b2a5-6fff758c8939
{
  "name": "SLO - Prod - API — latence des parcours critiques",
  "schedule": {
    "interval": "1m"
  },
  "tags": [
    "prod",
    "slo"
  ],
  "params": {
    "sloId": "6c55ac3b-8b07-400c-89f8-0e46865166b2",
    "windows": [
      {
        "id": "alert",
        "actionGroup": "slo.burnRate.alert",
        "burnRateThreshold": 14.4,
        "maxBurnRateThreshold": 100.0,
        "longWindow": {
          "value": 1,
          "unit": "h"
        },
        "shortWindow": {
          "value": 5,
          "unit": "m"
        }
      },
      {
        "id": "high",
        "actionGroup": "slo.burnRate.high",
        "burnRateThreshold": 6,
        "maxBurnRateThreshold": 100.0,
        "longWindow": {
          "value": 6,
          "unit": "h"
        },
        "shortWindow": {
          "value": 30,
          "unit": "m"
        }
      },
      {
        "id": "medium",
        "actionGroup": "slo.burnRate.medium",
        "burnRateThreshold": 3,
        "maxBurnRateThreshold": 100.0,
        "longWindow": {
          "value": 24,
          "unit": "h"
        },
        "shortWindow": {
          "value": 2,
          "unit": "h"
        }
      },
      {
        "id": "low",
        "actionGroup": "slo.burnRate.low",
        "burnRateThreshold": 1,
        "maxBurnRateThreshold": 100.0,
        "longWindow": {
          "value": 72,
          "unit": "h"
        },
        "shortWindow": {
          "value": 6,
          "unit": "h"
        }
      }
    ]
  },
  "actions": [
    {
      "group": "slo.burnRate.alert",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **SLO menacé — prod** — {{context.reason}}",
  "attachments": [
    {
      "color": "#d00000",
      "fields": [
        { "title": "SLO", "value": "{{context.sloName}}", "short": true },
        { "title": "Parcours / mode", "value": "`{{context.sloInstanceId}}`", "short": true },
        { "title": "Burn rate (longue / courte)", "value": "{{context.longWindow.burnRate}} / {{context.shortWindow.burnRate}} (seuil {{context.burnRateThreshold}})", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "SLO", "value": "[Budget d'erreur et historique]({{context.viewInAppUrl}})" },
        { "title": "Dashboard", "value": "[[Pass Emploi] SLO de PROD](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/b7c1e0d2-5f43-4a8e-9c61-2d8f3a9e7b14)" },
        { "title": "À vérifier", "value": "Alertes de diagnostic A1 à A3 en cours : partenaire en panne, 5xx, IDP" },
        { "title": "Runbook", "value": "[Investiguer un incident applicatif](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md)" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActionGroupChange",
        "throttle": null
      }
    },
    {
      "group": "slo.burnRate.high",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **SLO menacé — prod** — {{context.reason}}",
