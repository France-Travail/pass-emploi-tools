# A1 — Pic d'échecs partenaire (Warning)
PUT kbn:/api/alerting/rule/1b751543-4233-4857-8fe6-8141a7c2d040
{
  "name": "API - Prod - Pic d'échecs partenaire",
  "tags": [
    "prod",
    "applicatif"
  ],
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchType": "esqlQuery",
    "esqlQuery": {
      "esql": """FROM logs-prod-default
| WHERE event.action == "external_api_call" AND event.outcome == "failure"
| STATS echecs = COUNT(*), dont_crash = COUNT(*) WHERE log.level == "error",
        statuts = VALUES(http.response.status_code)
  BY log.logger
| WHERE echecs > 25"""
    },
    "timeField": "@timestamp",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "aggType": "count",
    "groupBy": "row",
    "termSize": 5,
    "sourceFields": [],
    "excludeHitsFromPreviousRun": false
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "⚠️ **Pic d'échecs partenaire — prod** — un client partenaire dépasse 25 échecs en 5 min.",
  "attachments": [
    {
      "color": "#f2c744",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "Détail", "value": "{{context.message}}" },
        { "title": "À vérifier", "value": "[Échecs des appels partenaires dans Discover](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/a28897ac-ecb1-4b4f-b413-0340c7241293)" },
        { "title": "Contacts partenaires", "value": "[Partenariats (Notion)](https://app.notion.com/p/Partenariats-2077bd17c27a812a8700e489fe8ca506) : qui prévenir chez le partenaire en panne" },
        { "title": "Runbook", "value": "[Investiguer un incident applicatif](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md)" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onThrottleInterval",
        "throttle": "1h"
      }
    }
  ]
}

# A2 — Erreurs serveur 5xx (Critical)
PUT kbn:/api/alerting/rule/98e0103a-f809-48f2-8343-d1269213dce4
{
  "name": "API - Prod - Erreurs 5xx",
  "tags": [
    "prod",
    "applicatif"
  ],
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchType": "esqlQuery",
    "esqlQuery": {
      "esql": """FROM logs-prod-default
| WHERE service.name == "pass-emploi-api" AND event.action == "request_failed"
| EVAL message = SUBSTRING(error.message, 1, 120)
| STATS erreurs_5xx = COUNT(*), statuts = VALUES(http.response.status_code),
        parcours = VALUES(labels.user_journey), messages = VALUES(message)
| WHERE erreurs_5xx > 5
| EVAL messages = MV_SLICE(messages, 0, 4)"""
    },
    "timeField": "@timestamp",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "aggType": "count",
    "groupBy": "row",
    "termSize": 5,
    "sourceFields": [],
    "excludeHitsFromPreviousRun": false
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **Erreurs 5xx — prod** — plus de 5 requêtes en erreur serveur en 5 min.",
  "attachments": [
    {
      "color": "#d00000",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "Détail", "value": "{{context.message}}" },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Logs de Prod - Erreurs serveur 5xx](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/d076df50-1625-443b-978c-1aa9a1288e73), liste les logs des requêtes HTTP 5xx avec le motif et le `trace.id` pour remonter la requête" },
        { "title": "Runbook", "value": "[Investiguer un incident applicatif](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md)" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onThrottleInterval",
        "throttle": "1h"
      }
    }
  ]
}

# A3 — Pic d'authentifications refusées (Critical)
PUT kbn:/api/alerting/rule/ad326ad3-aea7-4ef8-be28-31008c4aebce
{
  "name": "API - Prod - Pic d'auth refusées",
  "tags": [
    "prod",
    "applicatif"
  ],
  "schedule": {
    "interval": "5m"
  },
  "params": {
    "searchType": "esqlQuery",
    "esqlQuery": {
      "esql": """FROM logs-prod-default
| WHERE event.action == "auth_failed"
| EVAL recent = @timestamp >= NOW() - 10 minutes,
       meme_heure = @timestamp < NOW() - 1 day
                AND DATE_EXTRACT("HOUR_OF_DAY", @timestamp) == DATE_EXTRACT("HOUR_OF_DAY", NOW())
| STATS refus = COUNT(*) WHERE recent, historique = COUNT(*) WHERE meme_heure
| EVAL reference = ROUND(historique / 42.0, 1)
| WHERE refus >= 20 AND refus > 3 * reference"""
    },
    "timeField": "@timestamp",
    "timeWindowSize": 8,
    "timeWindowUnit": "d",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "aggType": "count",
    "groupBy": "row",
    "termSize": 5,
    "sourceFields": [],
    "excludeHitsFromPreviousRun": false
  },
  "actions": [
    {
      "group": "query matched",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **Pic d'authentifications refusées — prod** — plus de 3 × la normale sur 10 min : IDP ou Keycloak probablement en cause.",
  "attachments": [
    {
      "color": "#d00000",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "Détail", "value": "{{context.message}}" },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Logs de Prod - Erreurs d'authentification](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8), liste les logs de type `auth_failed` avec le motif de l'erreur d'habilitation - L'onglet `Field statistics` permet de comprendre la répartition (Ex : Quels IDP touchés ?)" },
        { "title": "Runbook", "value": "[Investiguer un incident applicatif](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md)" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onThrottleInterval",
        "throttle": "1h"
      }
    }
  ]
}
