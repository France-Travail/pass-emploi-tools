        },
        {
          "title": "Discover sessions",
          "value": "[[Pass Emploi] Logs de Prod - Jobs](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/c0d38bba-66ef-4b68-8a10-4d786f6a9f4a)"
        }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onActiveAlert",
        "throttle": null
      }
    },
    {
      "id": "system-connector-.workflows",
