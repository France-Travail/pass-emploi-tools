        "burnRateThreshold": 1.5,
        "maxBurnRateThreshold": 6.67,
        "longWindow": {
          "value": 24,
          "unit": "h"
        },
        "shortWindow": {
          "value": 2,
          "unit": "h"
        }
      },
      {
        "id": "low",
        "actionGroup": "slo.burnRate.low",
        "burnRateThreshold": 1,
        "maxBurnRateThreshold": 6.67,
        "longWindow": {
          "value": 72,
          "unit": "h"
        },
        "shortWindow": {
          "value": 6,
          "unit": "h"
        }
      }
    ]
  },
  "actions": [
    {
      "group": "slo.burnRate.alert",
      "id": "12e46700-6e45-11ec-9757-c9700cd1bb4e",
      "params": {
        "body": """{
  "text": "🚨 **SLO menacé — connexion des jeunes France Travail (prod)**",
  "attachments": [
    {
      "color": "#d00000",
      "fields": [
        {
