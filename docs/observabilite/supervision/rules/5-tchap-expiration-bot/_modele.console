# Expiration du compte bot Tchap. Spécification et procédure :
# ../../../runbooks/runbook-tchap-expiration-bot.md.
#
# Le compte du bot est un compte Tchap ordinaire : il expire s'il n'est pas
# renouvelé (CGU du 2026-10-14 : lien envoyé par email 11 mois après
# l'inscription ou le dernier renouvellement, expiration 60 jours plus tard ; à
# revérifier à chaque renouvellement, cf. runbook). Matrix ne donne pas
# cette date au titulaire du compte, et un bot expiré ne peut plus notifier :
# on range la date dans Elasticsearch et on alerte dans les 60 jours qui
# précèdent, tant que le bot fonctionne encore.
# À rejouer dans l'ordre : pipeline, index, date du compte, règle.

PUT _ingest/pipeline/tchap-expiration-bot
{
  "description": "Date à partir de laquelle renouveler le compte bot Tchap, et ligne de notification",
  "processors": [
    {
      "script": {
        "description": "renouveler_a_partir_du = expire_le - 60 jours (date d'envoi du lien de renouvellement)",
        "source": """
          LocalDate expiration = LocalDate.parse(ctx.expire_le.substring(0, 10));
          ctx.renouveler_a_partir_du = expiration.minusDays(60).toString();
          ctx.message = ctx.compte + ' expire le ' + expiration
            + ' : cliquer le lien de renouvellement reçu par email, puis mettre à jour la date';
        """
      }
    }
  ]
}

PUT tchap-expiration-bot
{
  "settings": {
    "number_of_replicas": 0,
    "index.default_pipeline": "tchap-expiration-bot"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "compte": { "type": "keyword" },
      "expire_le": { "type": "date" },
      "renouveler_a_partir_du": { "type": "date" },
      "message": { "type": "text" }
    }
  }
}

# Date d'expiration du compte : à la création, date d'inscription + 11 mois +
# 60 jours ; après chaque renouvellement, date du renouvellement + 13 mois
# (cf. runbook). <identifiant-du-bot> : le user_id renvoyé par le login du bot.
# Un seul document, toujours l'id « bot ».
PUT tchap-expiration-bot/_doc/bot?refresh=true
{
  "compte": "<identifiant-du-bot>",
  "expire_le": "<date-expiration>"
}

@@REGLE expiration-bot@@
