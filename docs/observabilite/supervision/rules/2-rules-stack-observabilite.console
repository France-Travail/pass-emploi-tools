# 3a — Absence dans `logs-prod-default`
PUT kbn:/api/alerting/rule/139c93c3-b744-4bd7-8274-bb88f77305c7
{
  "name": "Logstash - Prod - Détection absence ingestion logs applicatifs",
  "tags": [
    "prod",
    "o11y"
  ],
  "schedule": {
    "interval": "2m"
  },
  "params": {
    "searchConfiguration": {
