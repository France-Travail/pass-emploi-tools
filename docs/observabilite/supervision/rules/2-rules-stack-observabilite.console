# Règles Kibana de la stack d'observabilité, notifiées dans #o11y-production
# (Mattermost-o11y-production) et #o11y-staging (Mattermost-o11y-staging).
# Spécification et calibrage : ../alertes-stack-observabilite.md.
#
# À rejouer dans Dev Tools. PUT met à jour une règle existante ; sur un cluster
# vide, la créer avec POST kbn:/api/alerting/rule/<id> et le même corps plus
# "rule_type_id": ".es-query" et "consumer": "alerts".
#
# PUT ne change pas l'état activé / désactivé d'une règle. Les data views sont
# embarquées dans la règle (searchConfiguration.index) : leur id ne renvoie à
# aucune data view enregistrée.

# 1a — DLQ prod (Critical)
PUT kbn:/api/alerting/rule/fe53ada2-2c8b-42eb-930c-bae4286b7893
{
  "name": "Logstash - Prod - Détection présence event dans DLQ",
  "tags": [
    "prod",
    "o11y"
  ],
  "schedule": {
    "interval": "1m"
  },
  "params": {
    "searchConfiguration": {
      "query": {
        "query": "",
        "language": "kuery"
      },
      "index": {
        "id": "b5459fcf-9a0c-45d9-8ab0-f812cf7ddbb3",
        "title": "logs-logstash-dlq-prod-default",
        "timeFieldName": "@timestamp",
        "sourceFilters": [],
        "fieldFormats": {},
        "runtimeFieldMap": {},
        "allowNoIndex": false,
        "name": "Logs Logstash Prod - Dead Letter Queue",
        "allowHidden": true,
        "managed": false
      }
    },
    "timeField": "@timestamp",
    "searchType": "searchSource",
    "timeWindowSize": 5,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "aggType": "count",
    "groupBy": "all",
    "termSize": 5,
    "excludeHitsFromPreviousRun": false,
    "sourceFields": []
  },
  "actions": [
    {
      "group": "query matched",
      "id": "d2812573-52bf-4b48-9e54-a79a8b5b227d",
      "params": {
        "body": """{
  "text": "🚨 **Logs de prod non indexés : échec de process Logstash indéterminé** — des logs de prod ne sont pas consultables dans Kibana, sans erreur détectée par Logstash.",
  "attachments": [
    {
      "color": "#d00000",
      "fields": [
        { "title": "Règle", "value": "`{{rule.name}}`", "short": true },
        { "title": "Déclenchée à", "value": "`{{date}}`", "short": true },
        { "title": "Dashboard", "value": "[[Metrics Logstash] Elasticsearch output plugin info](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-4bbf4a50-6ece-11ee-910d-eb0006359086)" },
        { "title": "À vérifier", "value": "Le Discover [[Pass Emploi] Logs de Prod - DLQ Logstash Process](https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/97e2d85f-7bd2-49df-86b3-2ffc290bbe69), liste les logs avec le motif de rejet d'Elasticsearch (mapping, document trop gros…)" },
        { "title": "Runbook", "value": "[Runbook scénario](https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-3--rejet-de-mapping--dead-letter-queue)" }
      ]
    }
  ]
}"""
      },
      "frequency": {
        "summary": false,
        "notify_when": "onThrottleInterval",
        "throttle": "6h"
      }
    }
  ]
}

