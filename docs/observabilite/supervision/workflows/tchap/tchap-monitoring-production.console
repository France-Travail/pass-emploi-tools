# Workflow du salon Tchap monitoring-production, généré par generer-workflows.py depuis les
# règles de ../../rules/ : ne pas modifier à la main. Spécification : README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation.
# Le foreach écarte les alertes en attente de rétablissement
# (pending_recovered_count > 0) : une alerte qui bagote reste « active », à 0
# document, plusieurs exécutions, et l'action .workflows la transmet quand même.
# Mise à jour : PUT kbn:/api/workflows/workflow/tchap-monitoring-production avec {"yaml": …}.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-monitoring-production",
  "yaml": """
name: Tchap - monitoring-production
description: Envoie les alertes des règles dans le salon Tchap monitoring-production
enabled: true
triggers:
  - type: alert
consts:
  salon: "!wYxfADtvOcuPbjTOBU:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% case event.rule.id %}{% when 'e41ef1d8-efd8-449b-b2a5-6fff758c8939' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 259200 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign r = foreach.item.kibana.alert.reason | split: ' is ' %}{% assign ld = r[0] | split: ' ' | last %}{% assign lb = r[1] | split: ' ' | first | plus: 0 %}{% assign sd = r[1] | split: ' ' | last %}{% assign sb = r[2] | split: ' ' | first | plus: 0 %}{% assign s = foreach.item.kibana.alert.reason | split: 'above ' %}{% assign seuil = s[1] | split: ' ' | first %}🚨 SLO menacé — latence des parcours critiques (prod)\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nPromesse :\n99 % des requêtes des parcours critiques répondent en moins de 500 ms (authentification) ou 2,5 s (parcours avec un partenaire), sur 30 jours glissants.\nParcours / mode :\n{{ foreach.item.kibana.alert.instance.id | replace: '=', '＝' }}\nCe qui se passe :\nSur {{ ld | replace: 'h', ' h' | replace: 'm', ' min' }}, les requêtes trop lentes consomment la marge d'erreur du mois {{ lb | append: '' | replace: '.', ',' }} fois plus vite que prévu ({{ sb | append: '' | replace: '.', ',' }} fois sur les {{ sd | replace: 'h', ' h' | replace: 'm', ' min' }} les plus récentes). À ce rythme, elle est épuisée en {{ 30.0 | divided_by: lb | round: 1 | append: '' | replace: '.', ',' }} jours.\nÀ vérifier :\n1. Quel parcours ralentit, et depuis quand : le dashboard [Pass Emploi] SLO de Prod\n2. Si un partenaire répond lentement ou échoue (France Travail, Milo…) : le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée, puis le Discover [Pass Emploi] Logs de Prod - Échecs partenaires\n3. Si l'api répond en erreur : le Discover [Pass Emploi] Logs de Prod - Erreurs serveur 5xx\nDashboards :\n[Pass Emploi] SLO de Prod - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/b7c1e0d2-5f43-4a8e-9c61-2d8f3a9e7b14?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Échecs partenaires - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/a28897ac-ecb1-4b4f-b413-0340c7241293?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Logs de Prod - Erreurs serveur 5xx - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/d076df50-1625-443b-978c-1aa9a1288e73?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nMarge d'erreur :\nBudget d'erreur et historique du SLO - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/slos/{{ foreach.item.slo.id }}\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '72914c41-01ed-4ce7-ae68-a1b5eb445773' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 259200 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign r = foreach.item.kibana.alert.reason | split: ' is ' %}{% assign ld = r[0] | split: ' ' | last %}{% assign lb = r[1] | split: ' ' | first | plus: 0 %}{% assign sd = r[1] | split: ' ' | last %}{% assign sb = r[2] | split: ' ' | first | plus: 0 %}{% assign s = foreach.item.kibana.alert.reason | split: 'above ' %}{% assign seuil = s[1] | split: ' ' | first %}🚨 SLO menacé — connexion des jeunes France Travail (prod)\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nPromesse :\n85 % des connexions des jeunes France Travail aboutissent, hors refus métier, sur 30 jours glissants.\nCe qui se passe :\nSur {{ ld | replace: 'h', ' h' | replace: 'm', ' min' }}, les connexions en échec consomment la marge d'erreur du mois {{ lb | append: '' | replace: '.', ',' }} fois plus vite que prévu ({{ sb | append: '' | replace: '.', ',' }} fois sur les {{ sd | replace: 'h', ' h' | replace: 'm', ' min' }} les plus récentes). À ce rythme, elle est épuisée en {{ 30.0 | divided_by: lb | round: 1 | append: '' | replace: '.', ',' }} jours.\nÀ vérifier :\n1. Quel mode de connexion échoue, et depuis quand : le dashboard [Pass Emploi] SLO de Prod\n2. Le motif des connexions refusées (fournisseur d'identité, Keycloak) : le Discover [Pass Emploi] Logs de Prod - Erreurs d'authentification\n3. Si un fournisseur d'identité ou un partenaire est en panne : le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée\nDashboards :\n[Pass Emploi] SLO de Prod - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/b7c1e0d2-5f43-4a8e-9c61-2d8f3a9e7b14?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nMarge d'erreur :\nBudget d'erreur et historique du SLO - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/slos/{{ foreach.item.slo.id }}\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when 'ca02fee2-9d18-46bd-b2b9-dd96d8a6d593' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 259200 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign r = foreach.item.kibana.alert.reason | split: ' is ' %}{% assign ld = r[0] | split: ' ' | last %}{% assign lb = r[1] | split: ' ' | first | plus: 0 %}{% assign sd = r[1] | split: ' ' | last %}{% assign sb = r[2] | split: ' ' | first | plus: 0 %}{% assign s = foreach.item.kibana.alert.reason | split: 'above ' %}{% assign seuil = s[1] | split: ' ' | first %}🚨 SLO menacé — connexion par mode d'authentification (prod)\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nPromesse :\n99 % des connexions aboutissent, pour chaque mode d'authentification, hors refus métier, sur 30 jours glissants.\nParcours / mode :\n{{ foreach.item.kibana.alert.instance.id | replace: '=', '＝' }}\nCe qui se passe :\nSur {{ ld | replace: 'h', ' h' | replace: 'm', ' min' }}, les connexions en échec consomment la marge d'erreur du mois {{ lb | append: '' | replace: '.', ',' }} fois plus vite que prévu ({{ sb | append: '' | replace: '.', ',' }} fois sur les {{ sd | replace: 'h', ' h' | replace: 'm', ' min' }} les plus récentes). À ce rythme, elle est épuisée en {{ 30.0 | divided_by: lb | round: 1 | append: '' | replace: '.', ',' }} jours.\nÀ vérifier :\n1. Quel mode de connexion échoue, et depuis quand : le dashboard [Pass Emploi] SLO de Prod\n2. Le motif des connexions refusées (fournisseur d'identité, Keycloak) : le Discover [Pass Emploi] Logs de Prod - Erreurs d'authentification\n3. Si un fournisseur d'identité ou un partenaire est en panne : le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée\nDashboards :\n[Pass Emploi] SLO de Prod - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/b7c1e0d2-5f43-4a8e-9c61-2d8f3a9e7b14?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nMarge d'erreur :\nBudget d'erreur et historique du SLO - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/slos/{{ foreach.item.slo.id }}\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '8c760b1b-5859-410e-9a0d-829fb0499412' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 259200 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign r = foreach.item.kibana.alert.reason | split: ' is ' %}{% assign ld = r[0] | split: ' ' | last %}{% assign lb = r[1] | split: ' ' | first | plus: 0 %}{% assign sd = r[1] | split: ' ' | last %}{% assign sb = r[2] | split: ' ' | first | plus: 0 %}{% assign s = foreach.item.kibana.alert.reason | split: 'above ' %}{% assign seuil = s[1] | split: ' ' | first %}🚨 SLO menacé — connexion en mode invité (prod)\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nPromesse :\n90 % des connexions en mode invité aboutissent, hors refus métier, sur 30 jours glissants.\nCe qui se passe :\nSur {{ ld | replace: 'h', ' h' | replace: 'm', ' min' }}, les connexions en échec consomment la marge d'erreur du mois {{ lb | append: '' | replace: '.', ',' }} fois plus vite que prévu ({{ sb | append: '' | replace: '.', ',' }} fois sur les {{ sd | replace: 'h', ' h' | replace: 'm', ' min' }} les plus récentes). À ce rythme, elle est épuisée en {{ 30.0 | divided_by: lb | round: 1 | append: '' | replace: '.', ',' }} jours.\nÀ vérifier :\n1. Quel mode de connexion échoue, et depuis quand : le dashboard [Pass Emploi] SLO de Prod\n2. Le motif des connexions refusées (fournisseur d'identité, Keycloak) : le Discover [Pass Emploi] Logs de Prod - Erreurs d'authentification\n3. Si un fournisseur d'identité ou un partenaire est en panne : le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée\nDashboards :\n[Pass Emploi] SLO de Prod - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/b7c1e0d2-5f43-4a8e-9c61-2d8f3a9e7b14?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nMarge d'erreur :\nBudget d'erreur et historique du SLO - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/slos/{{ foreach.item.slo.id }}\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if foreach.item.labels %}{% if foreach.item.labels.depend