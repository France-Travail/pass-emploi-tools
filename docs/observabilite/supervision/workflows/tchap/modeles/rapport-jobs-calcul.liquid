{% assign ligne = nil %}
{% for v in steps.requete.output.values %}
{% if v[3] == j.type %}
{% assign ligne = v %}
{% endif %}
{% endfor %}
{% if ligne %}
{% assign n = ligne[0] %}
{% assign e = ligne[1] %}
{% assign d = ligne[2] | append: ' s' %}
{% else %}
{% assign n = 0 %}
{% assign e = 0 %}
{% assign d = '—' %}
{% endif %}
{% assign att = j.attendues %}
{% if j.jour %}
{% if j.minute < @@RAPPORT_HEURE@@ %}
{% assign ref = aujourdhui_jour %}
{% else %}
{% assign ref = hier_jour %}
{% endif %}
{% if j.jour contains ref %}
{% assign att = 1 %}
{% else %}
{% assign att = 0 %}
{% endif %}
{% endif %}
{% if j.semaine %}
{% if j.minute < @@RAPPORT_HEURE@@ %}
{% assign ref = aujourdhui_semaine %}
{% else %}
{% assign ref = hier_semaine %}
{% endif %}
{% if j.semaine contains ref %}
{% assign att = 1 %}
{% else %}
{% assign att = 0 %}
{% endif %}
{% endif %}
{% if n == att %}
{% assign tourne = '✅' %}
{% else %}
{% assign tourne = '❌' %}
{% endif %}
{% if e == 0 %}
{% assign ok = '✅' %}
{% else %}
{% assign ok = '❌' %}
{% endif %}
