FROM @@INDEX@@ | WHERE @timestamp >= NOW() - 30 days AND labels.run_id == "{{ steps.inventaire.output.values[0][0] }}" AND event.action != "inventory_completed" | EVAL ordre = CASE(labels.categorie == "stack_elastic_violation", 1, labels.categorie == "fin_de_vie" AND event.kind == "alert", 2, labels.categorie == "fin_de_vie", 3, labels.categorie == "stack_elastic_retard", 4, 5) | SORT ordre, versions.jours_restants, message | KEEP message | LIMIT 200
