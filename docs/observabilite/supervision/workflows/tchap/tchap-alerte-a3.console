# Workflow Tchap de la règle a3 (API - Prod - Pic d'auth refusées), généré par generer-workflows.py
# depuis ../../rules/ : ne pas modifier à la main. Spécification : README.md.
#
# La règle ES|QL est en groupBy all : son action .workflows ne transmet pas les lignes du
# résultat, le Workflow relance donc la requête sur la fenêtre de la règle. Le foreach
# écarte, comme les Workflows de salon, une alerte en attente de rétablissement.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-alerte-a3",
  "yaml": """
name: Tchap - alerte a3
description: "API - Prod - Pic d'auth refusées"
enabled: true
triggers:
  - type: alert
consts:
  salon: "!wYxfADtvOcuPbjTOBU:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: requete
        type: elasticsearch.esql.query
        with:
          query: "FROM logs-prod-default | WHERE @timestamp >= TO_DATETIME(\"{{ foreach.item.kibana.alert.start }}\") - 11520 minutes AND @timestamp <= TO_DATETIME(\"{{ foreach.item.kibana.alert.start }}\") | WHERE event.action == \"auth_failed\" | EVAL recent = @timestamp >= NOW() - 10 minutes, meme_heure = @timestamp < NOW() - 1 day AND DATE_EXTRACT(\"HOUR_OF_DAY\", @timestamp) == DATE_EXTRACT(\"HOUR_OF_DAY\", NOW()) | STATS refus = COUNT(*) WHERE recent, historique = COUNT(*) WHERE meme_heure | EVAL reference = ROUND(historique / 42.0, 1) | WHERE refus >= 20 AND refus > 3 * reference | EVAL reference = REPLACE(TO_STRING(reference), \"[.]\", \",\")"
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 604800 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Pic d'authentifications refusées — prod — plus de 3 × la normale sur 10 min : IDP ou Keycloak probablement en cause.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% for v in steps.requete.output.values %}\n• {{ v[0] | replace: '=', '＝' }} refus en 10 min, contre {{ v[2] | replace: '=', '＝' }} d'habitude à cette heure{% else %}\n• Plus de pic de refus à la relecture : il est peut-être en train de se résorber.{% endfor %}\nÀ vérifier :\n1. Un robot ou un scan en cause (volume anormal, codes hors 4xx) : le dashboard [Pass Emploi] Diagnostic d'erreurs - Robots / scan\n2. Si un seul fournisseur d'identité concentre les refus (France Travail Connect, Milo…) : sa disponibilité dans le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée ; si tous les modes sont touchés : Keycloak ou pass-emploi-connect, dans le dashboard [Pass Emploi] Diagnostic d'erreurs - Apps\n3. La liste des refus, par fournisseur d'identité et par motif : le Discover [Pass Emploi] Logs de Prod - Erreurs d'authentification, onglet *Field statistics*\nDashboards :\n[Pass Emploi] Diagnostic d'erreurs - Robots / scan - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/2fb2f360-3d6f-4efc-84b0-1d6c8788e8e6?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Apps - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/014dae91-507a-44de-b782-72e5eddbab74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}"
            html: "{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 604800 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#d00000\" color=\"#d00000\">🚨 <strong>Pic d'authentifications refusées — prod</strong> — plus de 3 × la normale sur 10 min : IDP ou Keycloak probablement en cause.</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p><ul>{% for v in steps.requete.output.values %}<li>{{ v[0] | replace: '=', '＝' | escape }} refus en 10 min, contre {{ v[2] | replace: '=', '＝' | escape }} d'habitude à cette heure</li>{% else %}<li>Plus de pic de refus à la relecture : il est peut-être en train de se résorber.</li>{% endfor %}</ul><p><strong>À vérifier</strong><br/>1. Un robot ou un scan en cause (volume anormal, codes hors 4xx) : le dashboard <strong>[Pass Emploi] Diagnostic d'erreurs - Robots / scan</strong><br/>2. Si un seul fournisseur d'identité concentre les refus (France Travail Connect, Milo…) : sa disponibilité dans le dashboard <strong>[Pass Emploi] Diagnostic d'erreurs - Entrée</strong> ; si tous les modes sont touchés : Keycloak ou pass-emploi-connect, dans le dashboard <strong>[Pass Emploi] Diagnostic d'erreurs - Apps</strong><br/>3. La liste des refus, par fournisseur d'identité et par motif : le Discover <strong>[Pass Emploi] Logs de Prod - Erreurs d'authentification</strong>, onglet *Field statistics*</p><p><strong>Dashboards</strong><br/>[Pass Emploi] Diagnostic d'erreurs - Robots / scan - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/2fb2f360-3d6f-4efc-84b0-1d6c8788e8e6?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29<br/>[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29<br/>[Pass Emploi] Diagnostic d'erreurs - Apps - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/014dae91-507a-44de-b782-72e5eddbab74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Runbook</strong><br/>Investiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>"
"""
}
