# Workflow Tchap de la règle a3 (API - Prod - Pic d'auth refusées), généré par generer-workflows.py
# depuis ../../rules/ : ne pas modifier à la main. Spécification : README.md.
#
# La règle ES|QL est en groupBy all : son action .workflows ne transmet pas les lignes du
# résultat, le Workflow relance donc la requête sur la fenêtre de la règle.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-alerte-a3",
  "yaml": """
name: Tchap - alerte a3
description: "API - Prod - Pic d'auth refusées"
enabled: true
triggers:
  - type: alert
consts:
  salon: "!wYxfADtvOcuPbjTOBU:agent.dinum.tchap.gouv.fr"
steps:
  - name: requete
    type: elasticsearch.esql.query
    with:
      query: "FROM logs-prod-default | WHERE @timestamp >= NOW() - 11520 minutes | WHERE event.action == \"auth_failed\" | EVAL recent = @timestamp >= NOW() - 10 minutes, meme_heure = @timestamp < NOW() - 1 day AND DATE_EXTRACT(\"HOUR_OF_DAY\", @timestamp) == DATE_EXTRACT(\"HOUR_OF_DAY\", NOW()) | STATS refus = COUNT(*) WHERE recent, historique = COUNT(*) WHERE meme_heure | EVAL reference = ROUND(historique / 42.0, 1) | WHERE refus >= 20 AND refus > 3 * reference"
  - name: notifier
    type: workflow.execute
    with:
      workflow-id: tchap-client
      inputs:
        salon: "{{ consts.salon }}"
        texte: "{% assign t0 = event.alerts[0].kibana.alert.start | date: '%s' | minus: 604800 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = event.alerts[0].kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Pic d'authentifications refusées — prod — plus de 3 × la normale sur 10 min : IDP ou Keycloak probablement en cause.\nDéclenchée à : {{ event.alerts[0].kibana.alert.start }}{% for v in steps.requete.output.values %}\n• {{ v[0] | replace: '=', '＝' }} refus en 10 min, contre {{ v[2] | replace: '=', '＝' }} d'habitude à cette heure{% else %}\n• Plus d'erreur au moment de l'envoi : l'incident s'est peut-être résorbé.{% endfor %}\nÀ vérifier :\n1. Quel mode de connexion est touché, et pourquoi : le Discover [Pass Emploi] Logs de Prod - Erreurs d'authentification, onglet *Field statistics* (répartition par fournisseur d'identité et par motif)\n2. Si un seul fournisseur d'identité concentre les refus (France Travail Connect, Milo…) : sa disponibilité dans le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée\n3. Si tous les modes sont touchés : Keycloak ou pass-emploi-connect, dans le dashboard [Pass Emploi] Diagnostic d'erreurs - Apps\nDashboards :\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Diagnostic d'erreurs - Apps - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/014dae91-507a-44de-b782-72e5eddbab74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if event.alerts[0].labels %}{% if event.alerts[0].labels.dependabot_url %}{% assign pages = event.alerts[0].labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = event.alerts[0].labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}"
        html: "{% assign t0 = event.alerts[0].kibana.alert.start | date: '%s' | minus: 604800 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = event.alerts[0].kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#d00000\" color=\"#d00000\">🚨 <strong>Pic d'authentifications refusées — prod</strong> — plus de 3 × la normale sur 10 min : IDP ou Keycloak probablement en cause.</font></p><p><strong>Déclenchée à</strong> : {{ event.alerts[0].kibana.alert.start }}</p><ul>{% for v in steps.requete.output.values %}<li>{{ v[0] | replace: '=', '＝' | escape }} refus en 10 min, contre {{ v[2] | replace: '=', '＝' | escape }} d'habitude à cette heure</li>{% else %}<li>Plus d'erreur au moment de l'envoi : l'incident s'est peut-être résorbé.</li>{% endfor %}</ul><p><strong>À vérifier</strong><br/>1. Quel mode de connexion est touché, et pourquoi : le Discover <strong>[Pass Emploi] Logs de Prod - Erreurs d'authentification</strong>, onglet *Field statistics* (répartition par fournisseur d'identité et par motif)<br/>2. Si un seul fournisseur d'identité concentre les refus (France Travail Connect, Milo…) : sa disponibilité dans le dashboard <strong>[Pass Emploi] Diagnostic d'erreurs - Entrée</strong><br/>3. Si tous les modes sont touchés : Keycloak ou pass-emploi-connect, dans le dashboard <strong>[Pass Emploi] Diagnostic d'erreurs - Apps</strong></p><p><strong>Dashboards</strong><br/>[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29<br/>[Pass Emploi] Diagnostic d'erreurs - Apps - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/014dae91-507a-44de-b782-72e5eddbab74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Logs de Prod - Erreurs d'authentification - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/1c0dfc0f-0534-4031-81c6-cee0d1c55de8?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Runbook</strong><br/>Investiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md</p>{% if event.alerts[0].labels %}{% if event.alerts[0].labels.dependabot_url %}{% assign pages = event.alerts[0].labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = event.alerts[0].labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>"
"""
}
