# ⚠️ FICHIER GÉNÉRÉ par ../generer-workflows.py : NE PAS LE MODIFIER, il serait écrasé.
# Il se construit depuis les règles (../../../rules/generated/), leurs définitions
# (../../../rules/<n>-<périmètre>/<code>.json) et, pour les rapports
# des jobs, la liste des CRON de pass-emploi-api. Pour changer un message : la définition
# de la règle (../../../rules/README.md). Puis : python3 -I ../generer-workflows.py
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
#
# Workflow du salon Tchap monitoring-securite, généré par generer-workflows.py depuis les
# règles de ../../../rules/generated/ : ne pas modifier à la main. Spécification : ../README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation.
# Le foreach écarte les alertes en attente de rétablissement
# (pending_recovered_count > 0) : une alerte qui bagote reste « active », à 0
# document, plusieurs exécutions, et l'action .workflows la transmet quand même.
# Règle ES|QL en groupBy all : son action ne transmet pas les lignes du résultat ; l'étape si-esql
# relance sa requête, lue dans l'alerte, sur la fenêtre de la règle avant le début de
# l'alerte (filtre sur @timestamp : une variable n'est pas remplacée dans un nom de champ).
# Mise à jour : le PUT ci-dessous, le Workflow existant déjà. Première création (404
# sur le PUT) : POST, en ajoutant l'id au corps, à côté de "yaml" :
#   POST kbn:/api/workflows/workflow
#   {
#     "id": "tchap-monitoring-securite",
#     "yaml": """
#   …le yaml du bloc ci-dessous, inchangé…
#   """
#   }
PUT kbn:/api/workflows/workflow/tchap-monitoring-securite
{
  "yaml": """
name: Tchap - monitoring-securite
description: Envoie les alertes des règles dans le salon Tchap monitoring-securite
enabled: true
triggers:
  - type: alert
consts:
  salon: "!KyybnZFjgagyAMYdSM:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: si-esql
        type: if
        condition: "${{ foreach.item.kibana.alert.rule.parameters.searchType == 'esqlQuery' and foreach.item.kibana.alert.rule.parameters.groupBy == 'all' }}"
        steps:
          - name: requete
            type: elasticsearch.esql.query
            with:
              query: "{{ foreach.item.kibana.alert.rule.parameters.esqlQuery.esql }}"
              filter:
                range:
                  "@timestamp":
                    gte: "{{ foreach.item.kibana.alert.start }}||-{{ foreach.item.kibana.alert.rule.parameters.timeWindowSize }}{{ foreach.item.kibana.alert.rule.parameters.timeWindowUnit }}"
                    lte: "{{ foreach.item.kibana.alert.start }}"
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% case event.rule.id %}{% when '67846c2c-45d1-45be-89f5-ce9a340240a0' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 CVE high/critical ouvertes ({{ foreach.item.kibana.alert.evaluation.value }})\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\n1. Le Discover [Pass Emploi] Alertes externes - CVE Dependabot, liste les CVE ouvertes par repo avec leur score\n2. Les alertes Dependabot du repo concerné (lien sur le nom du repo de chaque CVE), à traiter selon leur sévérité\nDiscover sessions :\n[Pass Emploi] Alertes externes - CVE Dependabot - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/ece3e409-0679-4bcb-a675-ae7dfb092c19?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '4b2e9f71-6c3d-4a85-b0e7-9d1f2c3a5e68' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Suspicion d'attaque DDoS — prod — requêtes par minute et erreurs 5xx au-delà de leurs seuils sur la même app.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% for v in steps.requete.output.values %}\n• {{ v[0] | replace: '=', '＝' }} : {{ v[1] | replace: '=', '＝' }}, 5xx : {{ v[2] | replace: '=', '＝' }}— depuis {{ v[3] | replace: '=', '＝' }}{% else %}\n• Sous le seuil à la relecture : l'incident est peut-être en train de se résorber.{% endfor %}\nÀ vérifier :\n1. Quelle app, depuis quand, et le trafic continue-t-il de monter : ses métriques (onglet Metrics) dans le dashboard [Scalingo] Dashboard des apps\n2. Un événement légitime l'explique-t-il : mise en service, notification de masse, campagne de communication\n3. D'où vient le trafic : si les logs du routeur arrivent encore (règle Logstash - Prod - Détection absence ingestion logs router au repos), le Discover [Pass Emploi] Logs de Prod - Trafic du routeur par IP sur la période ; sinon, les logs du routeur lus directement chez Scalingo, sans drain ni Logstash : scalingo --region osc-secnum-fr1 --app <app> logs --lines 5000, IP dans from＝, puis le support Scalingo\nDashboards :\n[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Trafic du routeur par IP - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md#suspicion-de-ddos-ou-surcharge-de-linfra{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '763950dd-eb65-426c-ae3a-714c35f1bc83' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Limite de débit déclenchée — prod — des requêtes sont refusées en 429.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% for v in steps.requete.output.values %}\n• {{ v[0] | replace: '=', '＝' }} / {{ v[1] | replace: '=', '＝' }} : {{ v[2] | replace: '=', '＝' }} lignes, jusqu'à {{ v[3] | replace: '=', '＝' }} refus dans une fenêtre — depuis {{ v[4] | replace: '=', '＝' }}{% else %}\n• Sous le seuil à la relecture : l'incident est peut-être en train de se résorber.{% endfor %}\nÀ vérifier :\n1. Qui est limité : Discover sur event.action: \"rate_limit_exceeded\", puis user.id ou client.ip, et url.path\n2. Légitime ou attaque : un pic attendu (ouverture, communication, atelier en Mission Locale), ou une IP ou un compte inconnu\n3. Si c'est légitime, monter le seuil concerné (RATE_LIMIT_* de l'app, cf. le CLAUDE.md de l'app) ; si c'est une attaque, croiser avec la règle Scalingo - Prod - Suspicion d'attaque DDoS et le Discover [Pass Emploi] Logs de Prod - Trafic du routeur par IP\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Trafic du routeur par IP - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% else %}{{ event.rule.name | replace: '=', '＝' }}\n{{ foreach.item.kibana.alert.reason | replace: '=', '＝' }}\n{{ event.ruleUrl }}{% endcase %}"
            html: "{% case event.rule.id %}{% when '67846c2c-45d1-45be-89f5-ce9a340240a0' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#d00000\" color=\"#d00000\">🚨 <strong>CVE high/critical ouvertes</strong> ({{ foreach.item.kibana.alert.evaluation.value }})</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p>{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}<ul>{% for ligne in foreach.item.message %}<li>{{ ligne | replace: '=', '＝' | escape }}</li>{% endfor %}</ul>{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}<table><thead><tr><th>Job</th><th>Échecs</th></tr></thead><tbody>{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}<tr><td>❌ {{ job | replace: '=', '＝' | escape }}</td><td>{{ nb }}</td></tr>{% endfor %}</tbody></table>{% if foreach.item.error.message %}<p><strong>Erreurs</strong><br/>{% for m in foreach.item.error.message %}{{ m | replace: '=', '＝' | escape }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>À vérifier</strong><br/>1. Le Discover <strong>[Pass Emploi] Alertes externes - CVE Dependabot</strong>, liste les CVE ouvertes par repo avec leur score<br/>2. Les alertes Dependabot du repo concerné (lien sur le nom du repo de chaque CVE), à traiter selon leur sévérité</p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Alertes externes - CVE Dependabot - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/ece3e409-0679-4bcb-a675-ae7dfb092c19?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>{% when '4b2e9f71-6c3d-4a85-b0e7-9d1f2c3a5e68' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#d00000\" color=\"#d00000\">🚨 <strong>Suspicion d'attaque DDoS — prod</strong> — requêtes par minute et erreurs 5xx au-delà de leurs seuils sur la même app.</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p><ul>{% for v in steps.requete.output.values %}<li><code>{{ v[0] | replace: '=', '＝' | escape }}</code> : {{ v[1] | replace: '=', '＝' | escape }}, 5xx : {{ v[2] | replace: '=', '＝' | escape }}— depuis {{ v[3] | replace: '=', '＝' | escape }}</li>{% else %}<li>Sous le seuil à la relecture : l'incident est peut-être en train de se résorber.</li>{% endfor %}</ul><p><strong>À vérifier</strong><br/>1. Quelle app, depuis quand, et le trafic continue-t-il de monter : ses métriques (onglet Metrics) dans le dashboard <strong>[Scalingo] Dashboard des apps</strong><br/>2. Un événement légitime l'explique-t-il : mise en service, notification de masse, campagne de communication<br/>3. D'où vient le trafic : si les logs du routeur arrivent encore (règle <strong>Logstash - Prod - Détection absence ingestion logs router</strong> au repos), le Discover <strong>[Pass Emploi] Logs de Prod - Trafic du routeur par IP</strong> sur la période ; sinon, les logs du routeur lus directement chez Scalingo, sans drain ni Logstash : <code>scalingo --region osc-secnum-fr1 --app &lt;app&gt; logs --lines 5000</code>, IP dans <code>from＝</code>, puis le support Scalingo</p><p><strong>Dashboards</strong><br/>[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps</p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Logs de Prod - Trafic du routeur par IP - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Runbook</strong><br/>Investiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md#suspicion-de-ddos-ou-surcharge-de-linfra</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>{% when '763950dd-eb65-426c-ae3a-714c35f1bc83' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#f2c744\" color=\"#f2c744\">⚠️ <strong>Limite de débit déclenchée — prod</strong> — des requêtes sont refusées en 429.</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p><ul>{% for v in steps.requete.output.values %}<li><code>{{ v[0] | replace: '=', '＝' | escape }}</code> / <code>{{ v[1] | replace: '=', '＝' | escape }}</code> : {{ v[2] | replace: '=', '＝' | escape }} lignes, jusqu'à {{ v[3] | replace: '=', '＝' | escape }} refus dans une fenêtre — depuis {{ v[4] | replace: '=', '＝' | escape }}</li>{% else %}<li>Sous le seuil à la relecture : l'incident est peut-être en train de se résorber.</li>{% endfor %}</ul><p><strong>À vérifier</strong><br/>1. Qui est limité : Discover sur <code>event.action: \"rate_limit_exceeded\"</code>, puis <code>user.id</code> ou <code>client.ip</code>, et <code>url.path</code><br/>2. Légitime ou attaque : un pic attendu (ouverture, communication, atelier en Mission Locale), ou une IP ou un compte inconnu<br/>3. Si c'est légitime, monter le seuil concerné (<code>RATE_LIMIT_*</code> de l'app, cf. le <code>CLAUDE.md</code> de l'app) ; si c'est une attaque, croiser avec la règle <strong>Scalingo - Prod - Suspicion d'attaque DDoS</strong> et le Discover <strong>[Pass Emploi] Logs de Prod - Trafic du routeur par IP</strong></p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Logs de Prod - Trafic du routeur par IP - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/7d3f1c2e-5b8a-4e6f-9c1d-2a4b6e8f0d13?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>{% else %}<p><strong>{{ event.rule.name | replace: '=', '＝' | escape }}</strong></p><p>{{ foreach.item.kibana.alert.reason | replace: '=', '＝' | escape }}</p><p>{{ event.ruleUrl }}</p>{% endcase %}"
"""
}
