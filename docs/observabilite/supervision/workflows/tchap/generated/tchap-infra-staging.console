# ⚠️ FICHIER GÉNÉRÉ par ../generer-workflows.py : NE PAS LE MODIFIER, il serait écrasé.
# Il se construit depuis les règles (../../../rules/generated/), leurs définitions
# (../../../rules/<n>-<périmètre>/<code>.json) et, pour les rapports
# des jobs, la liste des CRON de pass-emploi-api. Pour changer un message : la définition
# de la règle (../../../rules/README.md). Puis : python3 -I ../generer-workflows.py
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
#
# Workflow du salon Tchap infra-staging, généré par generer-workflows.py depuis les
# règles de ../../../rules/generated/ : ne pas modifier à la main. Spécification : ../README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation.
# Le foreach écarte les alertes en attente de rétablissement
# (pending_recovered_count > 0) : une alerte qui bagote reste « active », à 0
# document, plusieurs exécutions, et l'action .workflows la transmet quand même.
# Mise à jour : le PUT ci-dessous, le Workflow existant déjà. Première création (404
# sur le PUT) : POST, en ajoutant l'id au corps, à côté de "yaml" :
#   POST kbn:/api/workflows/workflow
#   {
#     "id": "tchap-infra-staging",
#     "yaml": """
#   …le yaml du bloc ci-dessous, inchangé…
#   """
#   }
PUT kbn:/api/workflows/workflow/tchap-infra-staging
{
  "yaml": """
name: Tchap - infra-staging
description: Envoie les alertes des règles dans le salon Tchap infra-staging
enabled: true
triggers:
  - type: alert
consts:
  salon: "!cyrJqnEKpRSPjSKIYF:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% case event.rule.id %}{% when '43e80d0c-dd21-4999-81af-92715cf44053' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}Opérations d'infra Scalingo des apps hors prod ({{ foreach.item.kibana.alert.evaluation.value }})\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nDashboards :\n[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% else %}{{ event.rule.name | replace: '=', '＝' }}\n{{ foreach.item.kibana.alert.reason | replace: '=', '＝' }}\n{{ event.ruleUrl }}{% endcase %}"
            html: "{% case event.rule.id %}{% when '43e80d0c-dd21-4999-81af-92715cf44053' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#808080\" color=\"#808080\"><strong>Opérations d'infra Scalingo des apps hors prod</strong> ({{ foreach.item.kibana.alert.evaluation.value }})</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p>{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}<ul>{% for ligne in foreach.item.message %}<li>{{ ligne | replace: '=', '＝' | escape }}</li>{% endfor %}</ul>{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}<table><thead><tr><th>Job</th><th>Échecs</th></tr></thead><tbody>{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}<tr><td>❌ {{ job | replace: '=', '＝' | escape }}</td><td>{{ nb }}</td></tr>{% endfor %}</tbody></table>{% if foreach.item.error.message %}<p><strong>Erreurs</strong><br/>{% for m in foreach.item.error.message %}{{ m | replace: '=', '＝' | escape }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Dashboards</strong><br/>[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>{% else %}<p><strong>{{ event.rule.name | replace: '=', '＝' | escape }}</strong></p><p>{{ foreach.item.kibana.alert.reason | replace: '=', '＝' | escape }}</p><p>{{ event.ruleUrl }}</p>{% endcase %}"
"""
}
