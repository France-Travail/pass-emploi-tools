le.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}<table><thead><tr><th>Job</th><th>Échecs</th></tr></thead><tbody>{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}<tr><td>❌ {{ job | replace: '=', '＝' | escape }}</td><td>{{ nb }}</td></tr>{% endfor %}</tbody></table>{% if foreach.item.error.message %}<p><strong>Erreurs</strong><br/>{% for m in foreach.item.error.message %}{{ m | replace: '=', '＝' | escape }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>À vérifier</strong><br/>1. Le lien de renouvellement reçu par email sur la boîte du bot : le cliquer avant la date d'expiration<br/>2. Une fois le compte renouvelé, la nouvelle date d'expiration dans l'index <code>tchap-expiration-bot</code>, comme l'indique le runbook</p><p><strong>Runbook</strong><br/>Expiration du compte bot Tchap - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-tchap-expiration-bot.md</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>{% else %}<p><strong>{{ event.rule.name | replace: '=', '＝' | escape }}</strong></p><p>{{ foreach.item.kibana.alert.reason | replace: '=', '＝' | escape }}</p><p>{{ event.ruleUrl }}</p>{% endcase %}"
"""
