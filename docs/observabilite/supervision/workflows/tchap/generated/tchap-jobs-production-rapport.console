# ⚠️ FICHIER GÉNÉRÉ par ../generer-workflows.py : NE PAS LE MODIFIER, il serait écrasé.
# Il se construit depuis les règles (../../../rules/generated/), leurs définitions
# (../../../rules/<n>-<périmètre>/<code>.json) et, pour les rapports
# des jobs, la liste des CRON de pass-emploi-api. Pour changer un message : la définition
# de la règle (../../../rules/README.md). Puis : python3 -I ../generer-workflows.py
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
#
# Rapport quotidien des jobs de pass-emploi-api (prod), chaque jour à 9 h 30
# (heure de Paris), dans le salon Tchap jobs-production. Généré par generer-workflows.py
# depuis la liste des CRON de pass-emploi-api (origin/develop) : ne pas modifier à
# la main. Spécification : ../../../alertes-applicatives.md.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-jobs-production-rapport",
  "yaml": """
name: Tchap - jobs-production - rapport quotidien des jobs
description: Exécutions des jobs de pass-emploi-api sur 24 h, dans le salon Tchap jobs-production
enabled: true
triggers:
  - type: scheduled
    with:
      rrule:
        freq: DAILY
        interval: 1
        tzid: Europe/Paris
        byhour: [9]
        byminute: [30]
consts:
  salon: "!vZkZkmTRLjAJTdkonL:agent.dinum.tchap.gouv.fr"
  jobs:
    - type: NOTIFIER_ACTUALISATION
      description: "Tous les 7 du mois à 8h."
      jour: [7]
      minute: 480
    - type: SUIVRE_FILE_EVENEMENTS_MILO
      description: "Toutes les 15 minutes."
      attendues: 96
    - type: RECUPERER_SITUATIONS_JEUNES_MILO
      description: "Tous les jours à 22h."
      attendues: 1
    - type: UPDATE_CONTACTS_CONSEILLER_MAILING_LISTS
      description: "Tous les jours à 1h."
      attendues: 1
    - type: NETTOYER_LES_PIECES_JOINTES
      description: "Tous les jours à 2h."
      attendues: 1
    - type: NETTOYER_LES_JOBS
      description: "Tous les jours à 4h. Supprime les jobs passés."
      attendues: 1
    - type: NETTOYER_LES_DONNEES
      description: "Tous les jours à 5h. Supprime les archives, les logs et les évènements d'engagement hebdo."
      attendues: 1
    - type: PURGER_INVITES_INACTIFS
      description: "Tous les jours à 6h. Purge les invités inactifs (ligne DB + identité connect)."
      attendues: 1
    - type: QUALIFIER_ACTIONS
      description: "Tous les jours à 6h. Qualifie en NON SNP les actions EN COURS il y a plus de 4 mois."
      attendues: 1
    - type: MAIL_CONSEILLER_MESSAGES
      description: "Du lundi au vendredi à 8h."
      semaine: [1, 2, 3, 4, 5]
      minute: 480
    - type: NOUVELLES_OFFRES_EMPLOI
      description: "Tous les jours à 9h."
      attendues: 1
    - type: NOTIFIER_RAPPEL_CREATION_ACTIONS_DEMARCHES
      description: "Tous les jeudi à 10h."
      semaine: [4]
      minute: 600
    - type: NOTIFIER_0_HEURES_DECLAREES
      description: "Tous les lundi à 16h."
      semaine: [1]
      minute: 960
    - type: NOUVELLES_OFFRES_SERVICE_CIVIQUE
      description: "Tous les jours à 11h."
      attendues: 1
    - type: NOTIFIER_RENDEZVOUS_PE
      description: "Toutes les 2 heures."
      attendues: 12
    - type: DUMP_ANALYTICS
      description: "Tous les jours à 2h30. Dump de la DB vers analytics."
      attendues: 1
    - type: MAJ_REFERENTIEL_ROME
      description: "Le 1er de chaque mois à 3h. Mise à jour du référentiel ROME."
      jour: [1]
      minute: 180
    - type: MAJ_REFERENTIEL_AGENCES_FT
      description: "Le 1er de chaque mois à 4h. Mise à jour du référentiel des agences France Travail."
      jour: [1]
      minute: 240
    - type: MAJ_REFERENTIEL_PLAN_ACTION
      description: "Tous les jours à 8h. Mise à jour du référentiel du plan d'action depuis Grist."
      attendues: 1
steps:
  - name: requete
    type: elasticsearch.esql.query
    with:
      query: "FROM logs-prod-default | WHERE @timestamp >= NOW() - 24 hours AND service.name == \"pass-emploi-api\" AND event.action == \"job_completed\" | STATS executions = COUNT(*), echecs = COUNT(*) WHERE event.outcome == \"failure\", duree_s = ROUND(AVG(event.duration) / 1000000000, 1) BY job = labels.job_type"
  - name: envoyer
    type: workflow.execute
    with:
      workflow-id: tchap-client
      inputs:
        salon: "{{ consts.salon }}"
        texte: "ℹ️ Rapport quotidien des jobs — prod (24 dernières heures){% assign maintenant = 'now' | date: '%s' | plus: 7200 %}{% assign jour_du_mois_aujourdhui = maintenant | date: '%-d' | plus: 0 %}{% assign jour_de_la_semaine_aujourdhui = maintenant | date: '%w' | plus: 0 %}{% assign hier = maintenant | minus: 86400 %}{% assign jour_du_mois_hier = hier | date: '%-d' | plus: 0 %}{% assign jour_de_la_semaine_hier = hier | date: '%w' | plus: 0 %}{% for job in consts.jobs %}{% assign resultat_du_job = nil %}{% for resultat in steps.requete.output.values %}{% if resultat[3] == job.type %}{% assign resultat_du_job = resultat %}{% endif %}{% endfor %}{% if resultat_du_job %}{% assign executions = resultat_du_job[0] %}{% assign echecs = resultat_du_job[1] %}{% assign duree_moyenne = resultat_du_job[2] | append: ' s' %}{% else %}{% assign executions = 0 %}{% assign echecs = 0 %}{% assign duree_moyenne = '—' %}{% endif %}{% assign executions_attendues = job.attendues %}{% if job.jour %}{% if job.minute < 570 %}{% assign jour_de_reference = jour_du_mois_aujourdhui %}{% else %}{% assign jour_de_reference = jour_du_mois_hier %}{% endif %}{% if job.jour contains jour_de_reference %}{% assign executions_attendues = 1 %}{% else %}{% assign executions_attendues = 0 %}{% endif %}{% endif %}{% if job.semaine %}{% if job.minute < 570 %}{% assign jour_de_reference = jour_de_la_semaine_aujourdhui %}{% else %}{% assign jour_de_reference = jour_de_la_semaine_hier %}{% endif %}{% if job.semaine contains jour_de_reference %}{% assign executions_attendues = 1 %}{% else %}{% assign executions_attendues = 0 %}{% endif %}{% endif %}{% if executions == executions_attendues %}{% assign a_tourne = '✅' %}{% else %}{% assign a_tourne = '❌' %}{% endif %}{% if echecs == 0 %}{% assign sans_echec = '✅' %}{% else %}{% assign sans_echec = '❌' %}{% endif %}\n{{ a_tourne }} {{ sans_echec }} {{ job.type }} : {{ executions }} exécution(s){% if executions_attendues %} sur {{ executions_attendues }} attendue(s){% endif %}, {{ echecs }} échec(s){% endfor %}{% assign types_suivis = consts.jobs | map: 'type' %}{% for resultat in steps.requete.output.values %}{% unless types_suivis contains resultat[3] %}\n— {% if resultat[1] == 0 %}✅{% else %}❌{% endif %} {{ resultat[3] }} : {{ resultat[0] }} exécution(s), {{ resultat[1] }} échec(s), hors CRON{% endunless %}{% endfor %}"
        html: "<p><font data-mx-color=\"#808080\" color=\"#808080\">ℹ️ <strong>Rapport quotidien des jobs — prod</strong> (24 dernières heures)</font></p><table><thead><tr><th>A tourné</th><th>Sans échec</th><th>Job</th><th>Attendues</th><th>Exécutions</th><th>Échecs</th><th>Durée moyenne</th><th>Description</th></tr></thead><tbody>{% assign maintenant = 'now' | date: '%s' | plus: 7200 %}{% assign jour_du_mois_aujourdhui = maintenant | date: '%-d' | plus: 0 %}{% assign jour_de_la_semaine_aujourdhui = maintenant | date: '%w' | plus: 0 %}{% assign hier = maintenant | minus: 86400 %}{% assign jour_du_mois_hier = hier | date: '%-d' | plus: 0 %}{% assign jour_de_la_semaine_hier = hier | date: '%w' | plus: 0 %}{% for job in consts.jobs %}{% assign resultat_du_job = nil %}{% for resultat in steps.requete.output.values %}{% if resultat[3] == job.type %}{% assign resultat_du_job = resultat %}{% endif %}{% endfor %}{% if resultat_du_job %}{% assign executions = resultat_du_job[0] %}{% assign echecs = resultat_du_job[1] %}{% assign duree_moyenne = resultat_du_job[2] | append: ' s' %}{% else %}{% assign executions = 0 %}{% assign echecs = 0 %}{% assign duree_moyenne = '—' %}{% endif %}{% assign executions_attendues = job.attendues %}{% if job.jour %}{% if job.minute < 570 %}{% assign jour_de_reference = jour_du_mois_aujourdhui %}{% else %}{% assign jour_de_reference = jour_du_mois_hier %}{% endif %}{% if job.jour contains jour_de_reference %}{% assign executions_attendues = 1 %}{% else %}{% assign executions_attendues = 0 %}{% endif %}{% endif %}{% if job.semaine %}{% if job.minute < 570 %}{% assign jour_de_reference = jour_de_la_semaine_aujourdhui %}{% else %}{% assign jour_de_reference = jour_de_la_semaine_hier %}{% endif %}{% if job.semaine contains jour_de_reference %}{% assign executions_attendues = 1 %}{% else %}{% assign executions_attendues = 0 %}{% endif %}{% endif %}{% if executions == executions_attendues %}{% assign a_tourne = '✅' %}{% else %}{% assign a_tourne = '❌' %}{% endif %}{% if echecs == 0 %}{% assign sans_echec = '✅' %}{% else %}{% assign sans_echec = '❌' %}{% endif %}<tr><td>{{ a_tourne }}</td><td>{{ sans_echec }}</td><td>{{ job.type }}</td><td>{{ executions_attendues | default: '—' }}</td><td>{{ executions }}</td><td>{{ echecs }}</td><td>{{ duree_moyenne }}</td><td>{{ job.description | escape }}</td></tr>{% endfor %}{% assign types_suivis = consts.jobs | map: 'type' %}{% for resultat in steps.requete.output.values %}{% unless types_suivis contains resultat[3] %}{% if resultat[1] == 0 %}{% assign sans_echec = '✅' %}{% else %}{% assign sans_echec = '❌' %}{% endif %}<tr><td>—</td><td>{{ sans_echec }}</td><td>{{ resultat[3] }}</td><td>—</td><td>{{ resultat[0] }}</td><td>{{ resultat[1] }}</td><td>{{ resultat[2] }} s</td><td>Hors CRON (lancé par un autre job ou un événement)</td></tr>{% endunless %}{% endfor %}</tbody></table><p><strong>Liens</strong><br/>[Pass Emploi] Logs de Prod - Jobs - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/c0d38bba-66ef-4b68-8a10-4d786f6a9f4a?_g=%28time%3A%28from%3Anow-24h%2Cto%3Anow%29%29</p>"
"""
}
