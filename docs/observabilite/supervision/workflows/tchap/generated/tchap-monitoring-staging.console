# ⚠️ FICHIER GÉNÉRÉ par ../generer-workflows.py : NE PAS LE MODIFIER, il serait écrasé.
# Il se construit depuis les règles (../../../rules/generated/), leurs définitions
# (../../../rules/<n>-<périmètre>/<code>.json) et, pour les rapports
# des jobs, la liste des CRON de pass-emploi-api. Pour changer un message : la définition
# de la règle (../../../rules/README.md). Puis : python3 -I ../generer-workflows.py
# La CI de chaque PR vérifie que ce fichier correspond à ses sources.
#
# Workflow du salon Tchap monitoring-staging, généré par generer-workflows.py depuis les
# règles de ../../../rules/generated/ : ne pas modifier à la main. Spécification : ../README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation.
# Le foreach écarte les alertes en attente de rétablissement
# (pending_recovered_count > 0) : une alerte qui bagote reste « active », à 0
# document, plusieurs exécutions, et l'action .workflows la transmet quand même.
# Mise à jour : PUT kbn:/api/workflows/workflow/tchap-monitoring-staging avec {"yaml": …}.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-monitoring-staging",
  "yaml": """
name: Tchap - monitoring-staging
description: Envoie les alertes des règles dans le salon Tchap monitoring-staging
enabled: true
triggers:
  - type: alert
consts:
  salon: "!ZfOFaCZYUWPLIxrYsx:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% case event.rule.id %}{% when '07c9c5d7-e8fe-4964-ac8d-684b1c4c39b8' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}Événements Scalingo des apps hors prod ({{ foreach.item.kibana.alert.evaluation.value }})\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\n1. Le Discover [Pass Emploi] Alertes externes Hors-Prod - Événements Scalingo, onglet « Incidents » ou « Infra » : l'événement, sa raison et son auteur\n2. L'activité de l'app (onglet Activity) dans le dashboard [Scalingo] Dashboard des apps\nDashboards :\n[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps\nDiscover sessions :\n[Pass Emploi] Alertes externes Hors-Prod - Événements Scalingo - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/33bed466-9d68-4789-a723-aeea34e6cd93?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% else %}{{ event.rule.name | replace: '=', '＝' }}\n{{ foreach.item.kibana.alert.reason | replace: '=', '＝' }}\n{{ event.ruleUrl }}{% endcase %}"
            html: "{% case event.rule.id %}{% when '07c9c5d7-e8fe-4964-ac8d-684b1c4c39b8' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#808080\" color=\"#808080\"><strong>Événements Scalingo des apps hors prod</strong> ({{ foreach.item.kibana.alert.evaluation.value }})</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p>{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}<ul>{% for ligne in foreach.item.message %}<li>{{ ligne | replace: '=', '＝' | escape }}</li>{% endfor %}</ul>{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}<table><thead><tr><th>Job</th><th>Échecs</th></tr></thead><tbody>{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}<tr><td>❌ {{ job | replace: '=', '＝' | escape }}</td><td>{{ nb }}</td></tr>{% endfor %}</tbody></table>{% if foreach.item.error.message %}<p><strong>Erreurs</strong><br/>{% for m in foreach.item.error.message %}{{ m | replace: '=', '＝' | escape }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>À vérifier</strong><br/>1. Le Discover <strong>[Pass Emploi] Alertes externes Hors-Prod - Événements Scalingo</strong>, onglet « Incidents » ou « Infra » : l'événement, sa raison et son auteur<br/>2. L'activité de l'app (onglet Activity) dans le dashboard <strong>[Scalingo] Dashboard des apps</strong></p><p><strong>Dashboards</strong><br/>[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps</p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Alertes externes Hors-Prod - Événements Scalingo - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/33bed466-9d68-4789-a723-aeea34e6cd93?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p>{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>{% else %}<p><strong>{{ event.rule.name | replace: '=', '＝' | escape }}</strong></p><p>{{ foreach.item.kibana.alert.reason | replace: '=', '＝' | escape }}</p><p>{{ event.ruleUrl }}</p>{% endcase %}"
"""
}
