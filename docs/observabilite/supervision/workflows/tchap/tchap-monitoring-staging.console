# Workflow du salon Tchap monitoring-staging : à choisir dans l'action
# .workflows d'une règle pour y envoyer ses alertes. Spécification : README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation. Ne parle pas à Matrix : construit le
# message et appelle tchap-client.
# La boucle doit être une étape « type: foreach » : une propriété foreach:
# posée sur l'étape workflow.execute est ignorée sans erreur.
# Mise à jour : PUT kbn:/api/workflows/workflow/tchap-monitoring-staging avec {"yaml": …}.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-monitoring-staging",
  "yaml": """
name: Tchap - monitoring-staging
description: Envoie les alertes de la règle dans le salon Tchap monitoring-staging
enabled: true
triggers:
  - type: alert
consts:
  salon: "!ZfOFaCZYUWPLIxrYsx:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | json }}"
    steps:
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% if event.rule.tags contains 'critical' %}🚨 {% elsif event.rule.tags contains 'warning' %}⚠️ {% endif %}{{ event.rule.name }}{% if foreach.item.kibana.alert.evaluation.value %} ({{ foreach.item.kibana.alert.evaluation.value }}){% endif %}{% if foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne }}{% endfor %}{% else %}\n• {{ foreach.item.kibana.alert.reason }}{% endif %}\nVoir la règle : {{ event.ruleUrl }}"
            html: "<p>{% if event.rule.tags contains 'critical' %}🚨 {% elsif event.rule.tags contains 'warning' %}⚠️ {% endif %}<strong>{{ event.rule.name | escape }}</strong>{% if foreach.item.kibana.alert.evaluation.value %} ({{ foreach.item.kibana.alert.evaluation.value }}){% endif %}</p><ul>{% if foreach.item.message %}{% for ligne in foreach.item.message %}<li>{{ ligne | escape }}</li>{% endfor %}{% else %}<li>{{ foreach.item.kibana.alert.reason | escape }}</li>{% endif %}</ul><p><a href=\"{{ event.ruleUrl }}\">Voir la règle</a> : vérifications, dashboards et Discover sessions dans son Investigation guide</p>"
"""
}
