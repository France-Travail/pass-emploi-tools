ic_agent-a148dc70-6b3c-11ed-98de-67bdecd21824\n[Elastic Agent] Agent metrics - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/elastic_agent-f47f18cc-9c7d-4278-b2ea-a6dee816d395\nFleet :\nFleet → Agents - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/fleet/agents\nDoc :\nPilotage des agents - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/pilotage.md{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '895bd492-e02f-4f18-b8e0-f453742c885f' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Mémoire conteneur Logstash staging/perf — un conteneur dépasse 95 % de sa limite Scalingo : OOM-kill imminent.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nConteneur :\n{{ foreach.item.kibana.alert.instance.id | replace: '=', '＝' }}\nDashboards :\n[Pass Emploi] Supervision Stack d'Observabilité - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/fd40a516-c323-4e5e-91e5-1328b8b1a78d\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-4--crash-du-conteneur-logstash{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% else %}{{ event.rule.name | replace: '=', '＝' }}\n{{ foreach.item.kibana.alert.reason | replace: '=', '＝' }}\n{{ event.ruleUrl }}{% endcase %}"
            html: "{% case event.rule.id %}{% when 'b100ff40-7409-4859-ac44-755ad2401f03' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#f2c744\" color=\"#f2c744\">⚠️ <strong>Logs hors prod non indexés : échec de process Logstash indéterminé</strong> — des logs de staging/perf ne sont pas consultables dans Kibana, sans erreur détectée par Logstash.</font></p><p><strong>Déclenchée à</strong> : {{ foreach.item.kibana.alert.start }}</p>{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}<ul>{% for ligne in foreach.item.message %}<li>{{ ligne | replace: '=', '＝' | escape }}</li>{% endfor %}</ul>{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}<table><thead><tr><th>Job</th><th>Échecs</th></tr></thead><tbody>{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}<tr><td>❌ {{ job | replace: '=', '＝' | escape }}</td><td>{{ nb }}</td></tr>{% endfor %}</tbody></table>{% if foreach.item.error.message %}<p><strong>Erreurs</strong><br/>{% for m in foreach.item.error.message %}{{ m | replace: '=', '＝' | escape }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>À vérifier</strong><br/>Le Discover <strong>[Pass Emploi] Logs Hors-Prod - DLQ Logstash Process</strong>, les logs désignent le motif de rejet d'Elasticsearch (mapping, document trop gros…)</p><p><strong>Dashboards</strong><br/>[Metrics Logstash] Elasticsearch output plugin info - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboar