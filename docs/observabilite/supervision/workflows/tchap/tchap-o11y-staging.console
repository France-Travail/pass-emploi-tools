# Workflow du salon Tchap o11y-staging, généré par generer-workflows.py depuis les
# règles de ../../rules/ : ne pas modifier à la main. Spécification : README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation.
# Le foreach écarte les alertes en attente de rétablissement
# (pending_recovered_count > 0) : une alerte qui bagote reste « active », à 0
# document, plusieurs exécutions, et l'action .workflows la transmet quand même.
# Mise à jour : PUT kbn:/api/workflows/workflow/tchap-o11y-staging avec {"yaml": …}.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-o11y-staging",
  "yaml": """
name: Tchap - o11y-staging
description: Envoie les alertes des règles dans le salon Tchap o11y-staging
enabled: true
triggers:
  - type: alert
consts:
  salon: "!EGmOEFBsJoXIngQOvU:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% case event.rule.id %}{% when 'b100ff40-7409-4859-ac44-755ad2401f03' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Logs hors prod non indexés : échec de process Logstash indéterminé — des logs de staging/perf ne sont pas consultables dans Kibana, sans erreur détectée par Logstash.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\nLe Discover [Pass Emploi] Logs Hors-Prod - DLQ Logstash Process, les logs désignent le motif de rejet d'Elasticsearch (mapping, document trop gros…)\nDashboards :\n[Metrics Logstash] Elasticsearch output plugin info - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-4bbf4a50-6ece-11ee-910d-eb0006359086\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-3--rejet-de-mapping--dead-letter-queue{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when 'ede49ade-b4ee-4cbb-9dd2-28078e189f7b' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Logs hors prod non indexés : erreur de transformation Logstash — des logs de staging/perf ne sont pas consultables dans Kibana.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\nLe Discover [Pass Emploi] Logs Hors-Prod - Erreurs de traitement Logstash Process, tags et message désignent le traitement et le log en échec\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-3--rejet-de-mapping--dead-letter-queue{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '32b686a2-659f-4b57-b583-e6aedaeea5f5' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Silence Logstash — aucun log dans logs-staging-default ou logs-perf-default depuis 5 min. Drain en quarantaine ou Logstash crashé.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nDashboards :\n[Metrics Logstash] Logstash Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-79270240-48ee-11ee-8cb5-99927777c522\n[Elastic Agent] Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/elastic_agent-a148d