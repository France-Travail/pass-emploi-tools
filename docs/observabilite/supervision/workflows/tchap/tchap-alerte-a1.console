# Workflow Tchap de la règle a1 (API - Prod - Pic d'échecs partenaire), généré par generer-workflows.py
# depuis ../../rules/ : ne pas modifier à la main. Spécification : README.md.
#
# La règle ES|QL est en groupBy all : son action .workflows ne transmet pas les lignes du
# résultat, le Workflow relance donc la requête sur la fenêtre de la règle.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-alerte-a1",
  "yaml": """
name: Tchap - alerte a1
description: "API - Prod - Pic d'échecs partenaire"
enabled: true
triggers:
  - type: alert
consts:
  salon: "!wYxfADtvOcuPbjTOBU:agent.dinum.tchap.gouv.fr"
steps:
  - name: requete
    type: elasticsearch.esql.query
    with:
      query: "FROM logs-prod-default | WHERE @timestamp >= TO_DATETIME(\"{{ event.alerts[0].kibana.alert.start }}\") - 5 minutes AND @timestamp <= TO_DATETIME(\"{{ event.alerts[0].kibana.alert.start }}\") | WHERE event.action == \"external_api_call\" AND event.outcome == \"failure\" AND url.domain IS NOT NULL | WHERE NOT url.domain LIKE \"*pass-emploi.beta.gouv.fr\" AND url.domain != \"stats.beta.gouv.fr\" | EVAL type = CASE(http.response.status_code == 429, \"429\", http.response.status_code >= 500, \"5xx\", http.response.status_code >= 400, \"4xx\", \"timeout / réseau\") | STATS echecs = COUNT(*), types = VALUES(type) BY partenaire = url.domain | WHERE echecs > 100 | EVAL types = MV_CONCAT(types, \", \") | SORT echecs DESC"
  - name: notifier
    type: workflow.execute
    with:
      workflow-id: tchap-client
      inputs:
        salon: "{{ consts.salon }}"
        texte: "{% assign t0 = event.alerts[0].kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = event.alerts[0].kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Pic d'échecs partenaire — prod — plus de 100 appels en échec vers un partenaire en 5 min.\nDéclenchée à : {{ event.alerts[0].kibana.alert.start }}{% for v in steps.requete.output.values %}\n• {{ v[1] | replace: '=', '＝' }} : {{ v[0] | replace: '=', '＝' }} échecs ({{ v[2] | replace: '=', '＝' }}){% else %}\n• Sous le seuil à la relecture : l'incident est peut-être en train de se résorber.{% endfor %}\nÀ vérifier :\n1. Quel partenaire, et quelles erreurs : les lignes ci-dessus (domaine, nombre et types d'échecs), puis le Discover [Pass Emploi] Logs de Prod - Échecs partenaires, onglet du partenaire\n2. L'impact pour les utilisateurs : les erreurs par parcours au même moment dans le dashboard [Pass Emploi] Diagnostic d'erreurs - Entrée\n3. Si la panne vient du partenaire : le prévenir (contacts ci-dessous) et suivre le retour à la normale dans le même Discover\nDashboards :\n[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nDiscover sessions :\n[Pass Emploi] Logs de Prod - Échecs partenaires - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/a28897ac-ecb1-4b4f-b413-0340c7241293?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\nContacts partenaires :\nPartenariats (Notion), qui prévenir chez le partenaire en panne - https://app.notion.com/p/Partenariats-2077bd17c27a812a8700e489fe8ca506\nRunbook :\nInvestiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md{% if event.alerts[0].labels %}{% if event.alerts[0].labels.dependabot_url %}{% assign pages = event.alerts[0].labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = event.alerts[0].labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}"
        html: "{% assign t0 = event.alerts[0].kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = event.alerts[0].kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}<p><font data-mx-color=\"#f2c744\" color=\"#f2c744\">⚠️ <strong>Pic d'échecs partenaire — prod</strong> — plus de 100 appels en échec vers un partenaire en 5 min.</font></p><p><strong>Déclenchée à</strong> : {{ event.alerts[0].kibana.alert.start }}</p><ul>{% for v in steps.requete.output.values %}<li><code>{{ v[1] | replace: '=', '＝' | escape }}</code> : {{ v[0] | replace: '=', '＝' | escape }} échecs ({{ v[2] | replace: '=', '＝' | escape }})</li>{% else %}<li>Sous le seuil à la relecture : l'incident est peut-être en train de se résorber.</li>{% endfor %}</ul><p><strong>À vérifier</strong><br/>1. Quel partenaire, et quelles erreurs : les lignes ci-dessus (domaine, nombre et types d'échecs), puis le Discover <strong>[Pass Emploi] Logs de Prod - Échecs partenaires</strong>, onglet du partenaire<br/>2. L'impact pour les utilisateurs : les erreurs par parcours au même moment dans le dashboard <strong>[Pass Emploi] Diagnostic d'erreurs - Entrée</strong><br/>3. Si la panne vient du partenaire : le prévenir (contacts ci-dessous) et suivre le retour à la normale dans le même Discover</p><p><strong>Dashboards</strong><br/>[Pass Emploi] Diagnostic d'erreurs - Entrée - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/eb348ed9-3bc2-4204-a5c2-c31465731c74?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Discover sessions</strong><br/>[Pass Emploi] Logs de Prod - Échecs partenaires - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/a28897ac-ecb1-4b4f-b413-0340c7241293?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29</p><p><strong>Contacts partenaires</strong><br/>Partenariats (Notion), qui prévenir chez le partenaire en panne - https://app.notion.com/p/Partenariats-2077bd17c27a812a8700e489fe8ca506</p><p><strong>Runbook</strong><br/>Investiguer un incident applicatif - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/investigation-incident.md</p>{% if event.alerts[0].labels %}{% if event.alerts[0].labels.dependabot_url %}{% assign pages = event.alerts[0].labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = event.alerts[0].labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}<p><strong>Alertes Dependabot</strong><br/>{% for u in pages %}{% assign morceaux = u | split: '/' %}{{ morceaux[4] | escape }} - {{ u }}{% unless forloop.last %}<br/>{% endunless %}{% endfor %}</p>{% endif %}{% endif %}<p><strong>Règle</strong><br/>{{ event.rule.name | replace: '=', '＝' | escape }} - {{ event.ruleUrl }}</p>"
"""
}
