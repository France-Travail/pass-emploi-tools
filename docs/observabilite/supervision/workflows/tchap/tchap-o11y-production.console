# Workflow du salon Tchap o11y-production, généré par generer-workflows.py depuis les
# règles de ../../rules/ : ne pas modifier à la main. Spécification : README.md.
#
# ID du salon : Tchap → paramètres du salon → Avancé. Ce n'est pas un secret :
# le salon est privé, sur invitation.
# Le foreach écarte les alertes en attente de rétablissement
# (pending_recovered_count > 0) : une alerte qui bagote reste « active », à 0
# document, plusieurs exécutions, et l'action .workflows la transmet quand même.
# Mise à jour : PUT kbn:/api/workflows/workflow/tchap-o11y-production avec {"yaml": …}.
POST kbn:/api/workflows/workflow
{
  "id": "tchap-o11y-production",
  "yaml": """
name: Tchap - o11y-production
description: Envoie les alertes des règles dans le salon Tchap o11y-production
enabled: true
triggers:
  - type: alert
consts:
  salon: "!GcUrxqTFizBjxwmsBO:agent.dinum.tchap.gouv.fr"
steps:
  - name: chaque-alerte
    type: foreach
    foreach: "{{ event.alerts | where_exp: 'a', 'a.kibana.alert.pending_recovered_count == blank or a.kibana.alert.pending_recovered_count == 0' | json }}"
    steps:
      - name: notifier
        type: workflow.execute
        with:
          workflow-id: tchap-client
          inputs:
            salon: "{{ consts.salon }}"
            texte: "{% case event.rule.id %}{% when 'fe53ada2-2c8b-42eb-930c-bae4286b7893' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Logs de prod non indexés : échec de process Logstash indéterminé — des logs de prod ne sont pas consultables dans Kibana, sans erreur détectée par Logstash.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\nLe Discover [Pass Emploi] Logs de Prod - DLQ Logstash Process, liste les logs avec le motif de rejet d'Elasticsearch (mapping, document trop gros…)\nDashboards :\n[Metrics Logstash] Elasticsearch output plugin info - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-4bbf4a50-6ece-11ee-910d-eb0006359086\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-3--rejet-de-mapping--dead-letter-queue{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when 'dd107070-c841-4580-9923-db2ef37c795d' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}⚠️ Logs de prod non indexés : erreur de transformation Logstash — bilan des 24 h — {{ foreach.item.kibana.alert.evaluation.value }} logs de prod ne sont pas consultables dans Kibana.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\nLe Discover [Pass Emploi] Logs de Prod - Erreurs de traitement Logstash Process, tags et message désignent le traitement et le log en échec\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-3--rejet-de-mapping--dead-letter-queue{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '139c93c3-b744-4bd7-8274-bb88f77305c7' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Silence Logstash — aucun log dans logs-prod-default depuis 5 min. Drain en quarantaine ou Logstash crashé.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nDashboards :\n[Metrics Logstash] Logstash Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-79270240-48ee-11ee-8cb5-99927777c522\n[Elastic Agent] Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/elastic_agent-a148dc70-6b3c-11ed-98de-67bdecd21824\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-4--crash-du-conteneur-logstash{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '6c2a2a83-9c40-4f40-af8d-911402932417' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Silence Logstash — aucun log router dans logs-router-prod-default depuis 5 min. Drain en quarantaine ou Logstash crashé.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nDashboards :\n[Metrics Logstash] Logstash Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-79270240-48ee-11ee-8cb5-99927777c522\n[Elastic Agent] Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/elastic_agent-a148dc70-6b3c-11ed-98de-67bdecd21824\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-4--crash-du-conteneur-logstash{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '204d560c-b6a6-4b5c-b4af-8d1fa6ce345c' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Backpressure Logstash prod — le pipeline ingest a au moins un thread HTTP bloqué en continu depuis 15 min (queue_backpressure ≥ 1) : l'écriture dans Redis ne suit plus, le drain Scalingo attend.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nNœud :\n{{ foreach.item.kibana.alert.instance.id | replace: '=', '＝' }}\nÀ vérifier :\nLe statut et la mémoire de Redis dans le dashboard Scalingo, puis le temps d'écriture de l'output redis dans Output plugin info\nDashboards :\n[Pass Emploi] Supervision Stack d'Observabilité - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/fd40a516-c323-4e5e-91e5-1328b8b1a78d\n[Metrics Logstash] Logstash Single Pipeline View - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-bc1a8050-5ee1-11ee-8e78-bf6865bc3ffc\n[Metrics Logstash] Input plugin Info - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-8f8c78a0-6e9e-11ee-86f6-d7074508d975\n[Metrics Logstash] Output plugin info - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-fe17b800-6eb4-11ee-86f6-d7074508d975\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-1--backpressure-elasticsearch{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when 'f8ff266d-84dc-4673-b95c-c3d32bf2ff04' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Heap JVM Logstash prod — le heap reste au-dessus de 90 % depuis 15 min : le GC ne libère plus, pauses stop-the-world et OutOfMemoryError en vue.\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nNœud :\n{{ foreach.item.kibana.alert.instance.id | replace: '=', '＝' }}\nÀ vérifier :\nLS_JAVA_OPTS : doit être -Xms256m -Xmx256m\nDashboards :\n[Pass Emploi] Supervision Stack d'Observabilité - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/fd40a516-c323-4e5e-91e5-1328b8b1a78d\n[Metrics Logstash] Single Node Overview - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/logstash-9d450b10-4680-11ee-9ddc-919f87fe352d\nRunbook :\nRunbook scénario - https://github.com/France-Travail/pass-emploi-tools/blob/master/docs/observabilite/runbooks/runbook-logstash.md#scénario-2--gel-gc-jvm{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when 'c16f2ab5-6103-4f69-bdc3-b4a10a38deb0' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}Événements Scalingo des apps de la stack, prod ({{ foreach.item.kibana.alert.evaluation.value }})\nDéclenchée à : {{ foreach.item.kibana.alert.start }}{% if event.rule.tags contains 'tchap-lignes' and foreach.item.message %}{% for ligne in foreach.item.message %}\n• {{ ligne | replace: '=', '＝' }}{% endfor %}{% elsif event.rule.tags contains 'jobs' and foreach.item.labels %}{% if foreach.item.labels.job_type %}{% assign jobs = foreach.item.labels.job_type | split: '@@' %}{% assign un = true %}{% else %}{% assign jobs = foreach.item.labels | map: 'job_type' | uniq %}{% assign un = false %}{% endif %}{% for job in jobs %}{% if un %}{% assign nb = 1 %}{% else %}{% assign nb = foreach.item.labels | where: 'job_type', job | size %}{% endif %}\n❌ {{ job | replace: '=', '＝' }} : {{ nb }} échec(s){% endfor %}{% if foreach.item.error.message %}\nErreurs :{% for m in foreach.item.error.message %}\n{{ m | replace: '=', '＝' }}{% endfor %}{% endif %}{% endif %}\nÀ vérifier :\n1. Le Discover [Pass Emploi] Alertes externes de Prod - Événements Scalingo, onglet « Incidents » ou « Infra » : l'événement, sa raison et son auteur\n2. Pour un incident sur une app Logstash, l'impact sur l'ingestion : le dashboard [Pass Emploi] Supervision Stack d'Observabilité, puis les Discover [Pass Emploi] Logs de Prod - DLQ Logstash Process et [Pass Emploi] Logs de Prod - Erreurs de traitement Logstash Process (logs non indexés)\n3. Les métriques (onglet Metrics) et l'activité (onglet Activity) de l'app dans le dashboard [Scalingo] Dashboard des apps\nDashboards :\n[Pass Emploi] Supervision Stack d'Observabilité - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/dashboards#/view/fd40a516-c323-4e5e-91e5-1328b8b1a78d\n[Scalingo] Dashboard des apps - https://dashboard.scalingo.com/apps\nDiscover sessions :\n[Pass Emploi] Alertes externes de Prod - Événements Scalingo - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/bb62451a-d9e9-4141-ab6f-2bda0e384e87?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Logs de Prod - DLQ Logstash Process - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/97e2d85f-7bd2-49df-86b3-2ffc290bbe69?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29\n[Pass Emploi] Logs de Prod - Erreurs de traitement Logstash Process - https://pass-emploi.kb.eu-west-3.aws.elastic-cloud.com/app/discover#/view/f10de9e3-0fdd-4761-9d44-bacc96504e17?_g=%28time%3A%28from%3A%27{{ t0 }}%27%2Cto%3A%27{{ t1 }}%27%29%29{% if foreach.item.labels %}{% if foreach.item.labels.dependabot_url %}{% assign pages = foreach.item.labels.dependabot_url | split: '@@' %}{% else %}{% assign pages = foreach.item.labels | map: 'dependabot_url' | compact | uniq %}{% endif %}{% if pages.size > 0 %}\nAlertes Dependabot :{% for u in pages %}{% assign morceaux = u | split: '/' %}\n{{ morceaux[4] }} - {{ u }}{% endfor %}{% endif %}{% endif %}\nRègle :\n{{ event.rule.name | replace: '=', '＝' }} - {{ event.ruleUrl }}{% when '07a8ee68-4994-4d70-b9a5-3d47f08297a5' %}{% assign t0 = foreach.item.kibana.alert.start | date: '%s' | minus: 3600 | date: '%Y-%m-%dT%H:%M:%SZ' %}{% assign t1 = foreach.item.kibana.alert.start | date: '%s' | plus: 900 | date: '%Y-%m-%dT%H:%M:%SZ' %}🚨 Backlog Redis prod — la liste logstash:ingest reste au-dessus de 1 000 événements depuis 15 min. Le pipeline process ne consomme plus Redis (redémarrage ou blocage de pass-emploi-logstash-process-prod, ou backpressure ES sévère).\nDéclenchée à : {{ foreach.ite