    { "_source": {"@timestamp":"2026-11-02T17:40:04Z","event":{"provider":"inventaire-versions","kind":"event","action":"end_of_life_detected","id":"inventaire-versions-20261102T174004Z/fin-de-vie/api/nodejs/22"},"service":{"name":"api"},"message":"⏳ api : node 22 en fin de vie le 2027-04-30, dans 179 j — prod 22.14.0, staging 22.14.0, perf 22.14.0, dépôt 22.14.0","labels":{"run_id":"inventaire-versions-20261102T174004Z","categorie":"fin_de_vie","brique":"node","produit":"nodejs","cycle":"22","eol":"2027-04-30","echeance":"moins_de_6_mois","derniere_version":"22.23.4"},"versions":{"jours_restants":179,"ou":[{"contexte":"perf","valeur":"22.14.0","source":"déployé","app":"pass-emploi-api-perf"},{"contexte":"prod","valeur":"22.14.0","source":"déployé","app":"pass-emploi-api-prod"},{"contexte":"staging","valeur":"22.14.0","source":"déployé","app":"pass-emploi-api-staging"},{"contexte":"depot","valeur":"22.14.0","source":"pass-emploi-api:.nvmrc"},{"contexte":"depot","valeur":"22.14.0","source":"pass-emploi-api:package.json"}]}} },
