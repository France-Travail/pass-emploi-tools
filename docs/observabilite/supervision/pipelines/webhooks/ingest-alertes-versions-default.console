# Pipeline par défaut de logs-alertes-versions-default. Spécification :
# README.md.
#
# L'émetteur (inventaire/inventaire-versions.sh --envoyer, plus tard le passage
# hebdomadaire des dépendances) écrit des documents déjà ECS, une ligne du
# rapport par document, message compris. Le pipeline ne transforme rien : il
# fait respecter ce contrat, pour qu'une ligne mal formée parte au failure store
# (règle 14) au lieu d'arriver illisible dans Tchap.
PUT _ingest/pipeline/ingest-alertes-versions-default
{
  "description": "Ligne du rapport de versions, déjà ECS → contrat vérifié",
  "processors": [
    {
      "script": {
        "description": "Champs obligatoires, event.kind, message d'une seule ligne, champs racine prévus",
        "source": """
          List erreurs = new ArrayList();
          if (ctx.event instanceof Map) {
            for (String champ : ['provider', 'kind', 'action', 'id']) {
              if (!(ctx.event[champ] instanceof String) || ctx.event[champ].isEmpty()) {
                erreurs.add('event.' + champ + ' absent');
              }
            }
            if (ctx.event.kind instanceof String && ctx.event.kind != 'alert' && ctx.event.kind != 'event') {
              erreurs.add('event.kind ' + ctx.event.kind + ' au lieu de alert ou event');
            }
          } else {
            erreurs.add('event absent');
          }
          if (!(ctx.service instanceof Map) || !(ctx.service.name instanceof String) || ctx.service.name.isEmpty()) {
            erreurs.add('service.name absent');
          }
          if (!(ctx.message instanceof String) || ctx.message.trim().isEmpty()) {
            erreurs.add('message absent');
          } else if (ctx.message.indexOf(10) >= 0 || ctx.message.indexOf(13) >= 0) {
            erreurs.add('message sur plusieurs lignes');
          } else if (ctx.message.length() > 500) {
            erreurs.add('message de plus de 500 caractères');
          }
          List prevus = ['@timestamp', 'event', 'service', 'message', 'labels', 'versions'];
          List inattendus = new ArrayList();
          for (String cle : ctx.keySet()) {
            if (!cle.startsWith('_') && !prevus.contains(cle)) {
              inattendus.add(cle);
            }
          }
          if (!inattendus.isEmpty()) {
            Collections.sort(inattendus);
            erreurs.add('champ racine non prévu (' + String.join(', ', inattendus) + ') : détails sous versions.*, dimensions sous labels.*');
          }
          if (!erreurs.isEmpty()) {
            ctx.rejet_versions = String.join(' ; ', erreurs);
          }
        """
      }
    },
    {
      "fail": {
        "if": "ctx.rejet_versions != null",
        "message": "Pas une ligne du rapport de versions : {{{rejet_versions}}}"
      }
    },
    {
      "set": {
        "field": "@timestamp",
        "value": "{{{_ingest.timestamp}}}",
        "override": false
      }
    },
    {
      "set": {
        "field": "event.ingested",
        "value": "{{{_ingest.timestamp}}}"
      }
    }
  ]
}

# ═════════════════════════════════════════════════════════════════════════════
# TESTS — rejouer après toute modification.
#
# Documents 1 à 6 : tirés de inventaire-versions.sh --simuler sur l'inventaire
# réel du 2026-11-02 → indexés tels quels, avec event.ingested en plus :
#   1. écart          event.kind: event, message "🔀 api : postgresql en écart — …"
#   2. retard Elastic event.kind: event, service.environment: prod
#   3. fin de vie dépassée  event.kind: alert, versions.jours_restants: -875
#   4. fin de vie < 30 j    event.kind: alert
#   5. fin de vie < 6 mois  event.kind: event
#   6. récapitulatif  event.outcome: success, versions.compteurs.ecarts: 17
# Document 7 : le retard 2 modifié en violation (aucune violation dans
#   l'inventaire réel) → event.kind: alert, message "🚨 … au-dessus du cluster …"
# Document 8 : sans @timestamp → @timestamp = heure d'ingestion
# Rejets (failure store en réel), message d'erreur attendu :
#   9.  message sur deux lignes → "Pas une ligne du rapport de versions : message sur plusieurs lignes"
#   10. sans service ni event.id, event.kind inconnu → "… : event.id absent ; event.kind info au lieu de alert ou event ; service.name absent"
#   11. champ racine hors contrat → "… : champ racine non prévu (cellules) : détails sous versions.*, dimensions sous labels.*"
#   12. payload d'une autre source → "… : event absent ; service.name absent ; message absent ; champ racine non prévu (security_advisory) : …"
POST _ingest/pipeline/ingest-alertes-versions-default/_simulate
{
  "docs": [
    { "_source": {"@timestamp":"2026-11-02T17:40:04Z","event":{"provider":"inventaire-versions","kind":"event","action":"version_mismatch_detected","id":"inventaire-versions-20261102T174004Z/ecart/api/postgresql"},"service":{"name":"api"},"message":"🔀 api : postgresql en écart — prod 15.13.0, staging 16.9.0, perf 17.11.0, ci 14, local 14","labels":{"run_id":"inventaire-versions-20261102T174004Z","categorie":"ecart","brique":"postgresql"},"versions":{"cellules":{"prod":[{"valeur":"15.13.0","source":"addon postgresql-business-8192"}],"staging":[{"valeur":"16.9.0","source":"addon postgresql-starter-512"}],"perf":[{"valeur":"17.11.0","source":"addon postgresql-starter-512"}],"depot":[],"ci":[{"valeur":"14","source":"pass-emploi-api:.github/workflows/tests-and-quality-checks.yml"}],"local":[{"valeur":"14","source":"pass-emploi-api:docker-compose.yml"}]}}} },
