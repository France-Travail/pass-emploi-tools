# Pipeline commun aux notifiers Scalingo : transforme l'événement en champs ECS.
# Appelé par ingest-alertes-scalingo-<env>-default, jamais directement en
# default_pipeline. Spécification : ../alertes-externes.md.
#
# À rejouer avant les pipelines par environnement. Enveloppe commune, vérifiée
# sur 3 captures réelles : {id, created_at, type, app_id, app_name, user,
# type_data}, type_data propre à chaque type. Constatés : alert, scale, restart.
# crash / repeated_crash / stop / start / deployment sont supposés d'après le
# catalogue Scalingo, à confirmer à la première capture (labels.scalingo_type).
PUT _ingest/pipeline/ingest-alertes-scalingo
{
  "description": "Événement d'un notifier webhook Scalingo → ECS",
  "processors": [
    {
      "script": {
        "description": "Range le payload brut sous scalingo.*, sans l'email de l'auteur",
        "source": """
          Map raw = new HashMap();
          for (String key : new ArrayList(ctx.keySet())) {
            if (!key.startsWith('_')) {
              raw.put(key, ctx.remove(key));
            }
          }
          if (raw.user instanceof Map && raw.user.username != null) {
            ctx.user = ['name': raw.user.username];
          }
          raw.remove('user');
          ctx.scalingo = raw;
        """
      }
    },
    {
      "date": {
        "field": "scalingo.created_at",
        "formats": ["ISO8601"],
        "target_field": "@timestamp"
      }
    },
    {
      "script": {
        "description": "service.name et service.environment, même règle que Logstash (suffixe -prod|-staging|-perf)",
        "source": """
          String app = ctx.scalingo.app_name;
          ctx.service = ['name': app];
          for (String env : ['prod', 'staging', 'perf']) {
            if (app.endsWith('-' + env)) {
              ctx.service.name = app.substring(0, app.length() - env.length() - 1);
              ctx.service.environment = env;
            }
          }
        """
      }
    },
    {
      "script": {
        "description": "event.* selon le type Scalingo",
        "params": {
          "actions": {
            "restart": "app_restarted",
            "scale": "app_scaled",
            "crash": "app_crashed",
            "repeated_crash": "app_crashed_repeatedly",
            "stop": "app_stopped",
            "start": "app_started",
            "deployment": "app_deployed"
          },
          "failures": ["crash", "repeated_crash"]
        },
        "source": """
          String type = ctx.scalingo.type;
          Map data = ctx.scalingo.type_data instanceof Map ? ctx.scalingo.type_data : new HashMap();
          Map event = ['provider': 'scalingo', 'id': ctx.scalingo.id, 'kind': 'event'];
          if (type == 'alert') {
            boolean activated = data.activated == true;
            event.kind = 'alert';
            event.action = activated ? 'resource_threshold_exceeded' : 'resource_threshold_recovered';
            event.outcome = activated ? 'failure' : 'success';
          } else if (params.actions.containsKey(type)) {
            event.action = params.actions[type];
          } else {
            event.action = 'scalingo_' + type;
          }
          if (params.failures.contains(type)) {
            event.outcome = 'failure';
          }
          if (data.reason != null) {
            event.reason = data.reason;
          }
          ctx.event = event;
        """
      }
    },
    {
      "script": {
        "description": "labels.* : ce qu'il faut lire dans la notification, par type",
        "source": """
          String formation(Map containers) {
            List keys = new ArrayList(containers.keySet());
            Collections.sort(keys);
            List parts = new ArrayList();
            for (def key : keys) {
              parts.add(key + '=' + containers[key]);
            }
            return String.join(' ', parts);
          }

          String type = ctx.scalingo.type;
          Map data = ctx.scalingo.type_data instanceof Map ? ctx.scalingo.type_data : new HashMap();
          Map labels = ['scalingo_type': type];
          if (type == 'alert') {
            for (String key : ['metric', 'value_text', 'limit_text']) {
              if (data[key] != null) {
                labels[key] = String.valueOf(data[key]);
              }
            }
            if (data.sender_name != null) {
              ctx.service.node = ['name': data.sender_name];
            }
          }
          if (data.containers instanceof Map) {
            boolean toZero = true;
            for (def size : data.containers.values()) {
              if (String.valueOf(size).splitOnToken(':')[0] != '0') {
                toZero = false;
              }
            }
            labels.formation = formation(data.containers);
            labels.scaled_to_zero = String.valueOf(toZero);
          }
          if (data.previous_containers instanceof Map) {
            labels.formation_before = formation(data.previous_containers);
          }
          if (data.scope instanceof List) {
            labels.scope = String.join(',', data.scope);
          }
          ctx.labels = labels;
        """
      }
    }
  ]
}

# ═════════════════════════════════════════════════════════════════════════════
# TESTS — rejouer après toute modification. Les 3 premiers documents sont les
# captures réelles du 2026-09-23 sur pass-emploi-logstash-perf (auteur
# anonymisé) ; attendus en tête de chaque bloc.

# alert → event.kind: alert, event.action: resource_threshold_exceeded,
#   event.outcome: failure, service.name: pass-emploi-logstash,
#   service.environment: perf, service.node.name: web-1, labels.metric: RAM
# scale → event.action: app_scaled, labels.formation: "web=0:L worker=0:L",
#   labels.formation_before: "web=1:L worker=0:L", labels.scaled_to_zero: "true"
# restart → event.action: app_restarted, event.reason: user_restart,
#   labels.scope: web, pas d'event.outcome (redémarrage volontaire)
POST _ingest/pipeline/ingest-alertes-scalingo/_simulate
{
  "docs": [
    { "_source": {"id":"6ab3f6dae12ccf4596ef2f6b","created_at":"2026-09-23T15:57:14.305Z","type":"alert","app_id":"6a9972b3d144aa4ac4db658b","app_name":"pass-emploi-logstash-perf","user":{"username":"scalingo-platform","email":"deploy@scalingo.com","id":"us-517145ac-9a8d-49b0-8766-0fdafedc4993"},"type_data":{"sender_name":"web-1","metric":"RAM","limit":0.9,"value":0.9695968627929688,"limit_text":"≥ 90.0 %","value_text":"96.96 %","activated":true,"send_when_below":false,"raw_limit":966367641.6,"raw_value":1041096704.0}} },
    { "_source": {"id":"6ab3f9858d0fd1438244ddb4","created_at":"2026-09-23T16:08:37.201Z","type":"scale","app_id":"6a9972b3d144aa4ac4db658b","app_name":"pass-emploi-logstash-perf","user":{"username":"prenom.nom","email":"prenom.nom@example.com","id":"us-00000000-0000-0000-0000-000000000000"},"type_data":{"previous_containers":{"web":"1:L","worker":"0:L"},"containers":{"web":"0:L","worker":"0:L"}}} },
    { "_source": {"id":"6ab3fc9805b3851e56c0404f","created_at":"2026-09-23T16:21:44.047Z","type":"restart","app_id":"6a9972b3d144aa4ac4db658b","app_name":"pass-emploi-logstash-perf","user":{"username":"prenom.nom","email":"prenom.nom@example.com","id":"us-00000000-0000-0000-0000-000000000000"},"type_data":{"scope":["web"],"reason":"user_restart"}} }
  ]
}

# crash (forme supposée, non capturée) → event.action: app_crashed,
#   event.outcome: failure, service.environment: prod
# type inconnu → event.action: scalingo_<type>, indexé quand même
POST _ingest/pipeline/ingest-alertes-scalingo/_simulate
{
  "docs": [
    { "_source": {"id":"test-crash","created_at":"2026-10-12T08:00:00.000Z","type":"crash","app_id":"test","app_name":"pass-emploi-api-prod","user":{"username":"scalingo-platform","email":"deploy@scalingo.com"},"type_data":{"scope":["web"],"reason":"oom"}} },
    { "_source": {"id":"test-inconnu","created_at":"2026-10-12T08:00:00.000Z","type":"new_variable","app_id":"test","app_name":"pass-emploi-api-staging","type_data":{"name":"LOG_LEVEL"}} }
  ]
}
