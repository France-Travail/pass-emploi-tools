PUT _index_template/logs-alertes-github@template-custom
{
  "index_patterns": ["logs-alertes-github-default"],
  "priority": 250,
  "composed_of": ["logs@mappings", "logs@settings", "ecs@mappings", "pass-emploi-logs@mappings", "logs-alertes@mappings", "logs-alertes-github@mappings", "logs-prod-retention-custom"],
  "template": {
    "settings": { "index": { "mode": "logsdb", "mapping": { "source": { "mode": "synthetic" } }, "default_pipeline": "ingest-alertes-github-default" } },
    "data_stream_options": { "failure_store": { "enabled": true } }
  },
  "data_stream": { "hidden": false, "allow_custom_routing": false },
  "allow_auto_create": true,
  "_meta": { "description": "CVE Dependabot remontées par security-alerts.yml", "managed_by": "pass-emploi-tools" },
  "version": 1
}

# Création à l'avance des 4 data streams et de leur failure store, à rejouer
# juste après leurs templates. Les règles A4a, A4b, 6a, 6b, 14, V1 et leurs sessions Discover
# partagent des data views : tant qu'aucun document n'est arrivé, ces data
# views ne trouvent aucun champ et les règles tombent en erreur (« Data view …
# no longer contains a time field »). Le failure store, lu par la règle 14, n'est créé
# qu'au premier rejet : son rollover le crée vide. Rejouer est sans effet sur
# les data streams existants (resource_already_exists_exception) et crée un
# nouvel index de failure store vide, sans dommage.
PUT _data_stream/logs-alertes-scalingo-prod-default
PUT _data_stream/logs-alertes-scalingo-staging-default
PUT _data_stream/logs-alertes-scalingo-perf-default
PUT _data_stream/logs-alertes-github-default
POST logs-alertes-scalingo-prod-default::failures/_rollover
POST logs-alertes-scalingo-staging-default::failures/_rollover
POST logs-alertes-scalingo-perf-default::failures/_rollover
POST logs-alertes-github-default::failures/_rollover

# ═════════════════════════════════════════════════════════════════════════════
# ROLLOVER (matérialisation) — action one-shot après un changement de template
#
# Nécessaire après tout changement de composed_of ou de settings qui doit
# s'appliquer aux nouveaux backing indices (les existants ne sont pas modifiés).
# Idempotence : rejouer crée un nouvel index vide, sans dommage.
#
# logs-router : passage de logs-prod-retention à logs-router-retention (historique)
POST logs-router-prod-default/_rollover
POST logs-router-staging-default/_rollover

# logs-prod/staging/perf : rollover one-shot pour forcer la rotation du write index
# (ex: index actif trop volumineux, changement de template à matérialiser).
POST logs-prod-default/_rollover
POST logs-staging-default/_rollover
POST logs-perf-default/_rollover

# logs-logstash-errors et logs-logstash-dlq : rollover one-shot après création
# des templates custom. Sans ce rollover, les backing indices créés avant
# l'application du template restent avec ilm_policy: logs (built-in, sans phase
# delete) au lieu de la policy de rétention dédiée. À rejouer si les data
# streams existaient déjà.
POST logs-logstash-errors-prod-default/_rollover
POST logs-logstash-errors-staging-default/_rollover
POST logs-logstash-errors-perf-default/_rollover

POST logs-logstash-dlq-prod-default/_rollover
POST logs-logstash-dlq-staging-default/_rollover
POST logs-logstash-dlq-perf-default/_rollover

# logs-apm.error : sa policy passe de traces-apm-retention (avant réorganisation
# des dossiers) à logs-apm.error-retention → les nouveaux backing indices doivent
# la prendre. Idempotence : rejouer crée un index vide, sans dommage.
POST logs-apm.error-default/_rollover
