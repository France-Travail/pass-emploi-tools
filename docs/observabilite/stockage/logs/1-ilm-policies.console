# Politiques ILM — logs (applicatif, router, DLQ/erreurs Logstash, erreurs APM).
#
# Logs = événements discrets (une ligne = un fait daté), au sens ECS. Distinct de
# traces/ (mesures de durée d'une requête) et metriques/ (mesures numériques
# périodiques). logs-apm.error est classé ici malgré son origine APM : c'est un
# événement discret (une erreur = une ligne), pas une série temporelle.
#
# Fenêtre HOT = ~14 j : `warm.min_age: 14d` (compté depuis le rollover, indépendant
# de la cadence). Rééquilibre le tier warm saturé vers le hot inutilisé. staging
# reste en warm 0 j (jetable). Le rollover reste piloté par la taille de shard.
#
# Prod, router et erreurs APM suivent le plan de rétention x3.1 du conseiller Elastic (2026-10-05) :
# 14 j hot + 7 j warm (1 réplica), puis frozen sans réplica jusqu'à la suppression.
# Phase frozen = searchable snapshot partiel sur le dépôt `found-snapshots`.

# Logs applicatifs prod — 90 j : 14 j hot, 7 j warm, 69 j frozen.
PUT _ilm/policy/logs-prod-retention
{
  "policy": {
    "phases": {
      "hot": { "min_age": "0ms", "actions": { "rollover": { "max_age": "30d", "max_primary_shard_size": "25gb" } } },
      "warm": { "min_age": "14d", "actions": { "set_priority": { "priority": 50 } } },
      "frozen": { "min_age": "21d", "actions": { "searchable_snapshot": { "snapshot_repository": "found-snapshots" } } },
      "delete": { "min_age": "90d", "actions": { "delete": { "delete_searchable_snapshot": true } } }
    }
  }
}

# Logs router prod/staging/perf — 21 j : 14 j hot, 7 j warm, pas de frozen.
# Opérationnel (analyse trafic/latence edge). Staging et perf partagent la policy
# de la prod : ils ne gardent pas leurs logs plus longtemps qu'elle.
PUT _ilm/policy/logs-router-retention
{
  "policy": {
    "phases": {
      "hot": { "min_age": "0ms", "actions": { "rollover": { "max_age": "30d", "max_primary_shard_size": "25gb" } } },
      "warm": { "min_age": "14d", "actions": { "set_priority": { "priority": 50 } } },
      "delete": { "min_age": "21d", "actions": { "delete": {} } }
    }
  }
}

# Logs de test de perf (workflow logstash-perf, appname=*-perf) — 2 j.
# Filet de sécurité : le nettoyage nominal est la purge post-test du workflow ;
# l'ILM couvre les runs interrompus (job annulé, purge en échec) et supprime les
# backing indices que _delete_by_query ne touche pas. 2 j laissent le temps de
# débugger un run de la veille ; au-delà la donnée n'a aucune valeur.
PUT _ilm/policy/logs-perf-retention
{
  "policy": {
    "phases": {
      "hot": { "min_age": "0ms", "actions": { "rollover": { "max_age": "1d", "max_primary_shard_size": "25gb" } } },
      "delete": { "min_age": "2d", "actions": { "delete": {} } }
    }
  }
}

# Erreurs de traitement Logstash.
# Indexés par le pipeline "process" quand un event déclenche _mutate_error,
# _jsonparsefailure, etc. Volume faible (anomalies) mais à conserver assez
# longtemps pour investiguer une régression de pipeline.
# Rollover à 1 GB : ces index sont petits, on évite les gros shards.
PUT _ilm/policy/logs-logstash-errors-retention
{
  "policy": {
    "phases": {
      "hot": { "min_age": "0ms", "actions": { "rollover": { "max_age": "30d", "max_primary_shard_size": "1gb" } } },
      "delete": { "min_age": "30d", "actions": { "delete": {} } }
    }
  }
}

# Events en Dead Letter Queue Logstash.
# Indexés par le pipeline "dead_letter_queue" quand dlq_on_failed_indexing
# renvoie un event (rejet ES : conflit de mapping, document trop grand, etc.).
# Même fenêtre d'investigation que logs-logstash-errors.
PUT _ilm/policy/logs-logstash-dlq-retention
{
  "policy": {
    "phases": {
      "hot": { "min_age": "0ms", "actions": { "rollover": { "max_age": "30d", "max_primary_shard_size": "1gb" } } },
      "delete": { "min_age": "30d", "actions": { "delete": {} } }
    }
  }
}

# Logs applicatifs staging — 14 j (jetable).
PUT _ilm/policy/logs-staging-retention
{
  "policy": {
    "phases": {
      "hot": { "min_age": "0ms", "actions": { "rollover": { "max_age": "7d", "max_primary_shard_size": "25gb" } } },
      "warm": { "min_age": "0d", "actions": { "set_priority": { "priority": 50 } } },
      "delete": { "min_age": "14d", "actions": { "delete": {} } }
    }
  }
}

# Erreurs APM — 90 j (logs-apm.error-default) : 14 j hot, 7 j warm, 69 j frozen.
# Découplé de traces-apm-retention : le suivi des régressions d'erreurs a une
# valeur diagnostique plus longue que la trace brute (21 j).
PUT _ilm/policy/logs-apm.error-retention
{
  "policy": {
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "set_priority": { "priority": 100 },
          "rollover": { "max_age": "30d", "max_primary_shard_size": "20gb" }
        }
      },
      "warm": {
        "min_age": "14d",
        "actions": { "set_priority": { "priority": 50 } }
      },
      "frozen": {
        "min_age": "21d",
        "actions": { "searchable_snapshot": { "snapshot_repository": "found-snapshots" } }
      },
      "delete": {
        "min_age": "90d",
        "actions": { "delete": { "delete_searchable_snapshot": true } }
      }
    }
  }
}
