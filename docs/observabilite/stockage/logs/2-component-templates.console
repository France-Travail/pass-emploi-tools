# Component templates — logs (applicatif, router, DLQ/erreurs Logstash, erreurs APM).
# A importer apres 1-ilm-policies.console.

PUT _component_template/logs@custom
{
  "template": {
    "mappings": {
      "properties": {
        "log":   { "properties": { "logger": { "type": "keyword", "ignore_above": 1024 } } },
        "event": { "properties": {
          "action":  { "type": "keyword", "ignore_above": 1024 },
          "outcome": { "type": "keyword", "ignore_above": 1024 }
        } },
        "error": { "properties": {
          "type":        { "type": "keyword", "ignore_above": 1024 },
          "message":     { "type": "match_only_text" },
          "stack_trace": { "type": "wildcard", "fields": { "text": { "type": "match_only_text" } } }
        } },
        "milo": { "properties": {
          "error_response": { "properties": {
            "code":    { "type": "keyword", "ignore_above": 1024 },
            "message": { "type": "match_only_text" }
          } }
        } },
        "http": { "properties": {
          "response": { "properties": {
            "www_authenticate": { "type": "keyword", "ignore_above": 1024 },
            "retry_after":      { "type": "keyword", "ignore_above": 1024 }
          } }
        } },
        "login": { "properties": {
          "step": { "type": "keyword", "ignore_above": 1024 }
        } },
        "communication": { "dynamic": false, "properties": {
          "destinataires":    { "type": "long" },
          "restantes":        { "type": "long" },
          "a_envoyer":        { "type": "long" },
          "en_cours":         { "type": "long" },
          "envoyees":         { "type": "long" },
          "erreurs":          { "type": "long" },
          "tokens_invalides": { "type": "long" },
          "envois_liberes":   { "type": "long" },
          "lot": { "dynamic": false, "properties": {
            "envoyees":         { "type": "long" },
            "erreurs":          { "type": "long" },
            "tokens_invalides": { "type": "long" }
          } }
        } }
      }
    }
  },
  "_meta": { "description": "Champs ECS custom CEJ, communs app + router", "managed_by": "pass-emploi-tools" },
  "version": 6
}

PUT _component_template/logs-router@mappings
{
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": { "type": "date" },
        "service": { "properties": {
          "name": { "type": "keyword" },
          "node": { "properties": { "name": { "type": "keyword" } } }
        } },
        "client": { "properties": { "ip": { "type": "ip" } } },
        "http": { "properties": {
          "request":  { "properties": {
            "id": { "type": "keyword" }, "method": { "type": "keyword" }, "referrer": { "type": "keyword" }
          } },
          "response": { "properties": {
            "status_code": { "type": "short" },
            "body": { "properties": { "bytes": { "type": "long" } } }
          } }
        } },
        "url": { "properties": {
          "path": { "type": "wildcard" }, "scheme": { "type": "keyword" }, "domain": { "type": "keyword" }
        } },
        "event": { "properties": { "duration": { "type": "long" } } },
        "user_agent": { "properties": {
          "original": { "type": "keyword", "fields": { "text": { "type": "text" } } }
        } },
        "message": { "type": "text" }
      }
    }
  },
  "_meta": { "description": "Champs propres aux logs router Scalingo. dynamic:false ; event.action/outcome viennent de logs@custom", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-router@settings
{
  "template": {
    "settings": { "index": {
      "number_of_shards": "1",
      "number_of_replicas": "1"
    } }
  },
  "_meta": { "description": "Settings index des data streams router (shards/replicas ; rétention portée par logs-router-retention-custom)", "managed_by": "pass-emploi-tools" },
  "version": 2
}

# apm-retention-custom : brique PARTAGÉE avec ../traces/. Composée en dernier par
# logs-apm.error@template-custom (ce dossier) ET par traces-apm@template-custom,
# traces-apm.rum@template-custom (../traces/). Elle est VIDÉE (no-op) : chaque flux
# porte sa propre rétention via sa brique <flux>@custom dédiée. Définie UNE SEULE
# FOIS dans ../traces/2-component-templates.console — référencée seulement ici.

# Briques de rétention (une par flux, lifecycle uniquement) — pattern homogène.
PUT _component_template/logs-logstash-errors-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-logstash-errors-retention" } } } },
  "_meta": { "description": "Retention logs d'erreurs de traitement Logstash", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-logstash-dlq-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-logstash-dlq-retention" } } } },
  "_meta": { "description": "Retention events Dead Letter Queue Logstash", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-prod-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-prod-retention" } } } },
  "_meta": { "description": "Retention logs applicatifs prod", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-router-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-router-retention" } } } },
  "_meta": { "description": "Retention logs router (découplée de logs-prod)", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-staging-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-staging-retention" } } } },
  "_meta": { "description": "Retention logs applicatifs staging", "managed_by": "pass-emploi-tools" },
  "version": 1
}

PUT _component_template/logs-perf-retention-custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-perf-retention" } } } },
  "_meta": { "description": "Retention logs de test de perf (courte ; filet du workflow logstash-perf)", "managed_by": "pass-emploi-tools" },
  "version": 1
}

# Erreurs APM → logs-apm.error-retention (90 j). Classé "logs" au sens ECS
# (événement discret) malgré son origine APM — cf. 1-ilm-policies.console.
PUT _component_template/logs-apm.error@custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "logs-apm.error-retention" } } } },
  "_meta": { "managed_by": "pass-emploi-tools" }
}
