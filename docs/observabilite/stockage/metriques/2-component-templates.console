# Component templates — métriques (Fleet + heartbeat). A importer apres
# 1-ilm-policies.console.
#
# Pattern : une brique <type>-<dataset>@custom par flux (jamais de brique
# partagée mutualisée — même principe que apm-retention-custom vidée dans
# ../logs/ et ../traces/). Chaque intégration Fleet réserve déjà ce point
# d'ancrage par défaut (nom conventionnel), mais NE LE REMPLIT PAS — on le crée
# ici pour la première fois pour chacun des flux concernés.

# ─── Logstash (self-monitoring, co-localisé dans pass-emploi-logstash-<env>
#      et pass-emploi-logstash-process-<env>) ───
PUT _component_template/metrics-logstash.node@custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "metrics-fleet-retention" } } } },
  "_meta": { "description": "Retention métriques node Logstash (santé JVM/pipeline)", "managed_by": "pass-emploi-tools" }
}

PUT _component_template/metrics-logstash.pipeline@custom
{
  "template": { "settings": { "index": { "lifecycle": { "name": "metrics-fleet-retention" } } } },
  "_meta": { "description": "Retention métriques pipeline Logstash (backpressure, queues)", "managed_by": "pass-emploi-tools" }
}

